<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />

  <link rel="stylesheet" href="/assets/css/forgot_pass_style.css" />

  <link rel="stylesheet" href="/css/flash.css">

</head>

<body>

  <% if (success && success.length> 0) { %>
    <div id="successAlert" class="custom-alert success-alert">
      <i class="fa-solid fa-circle-check"></i>
      <span>
        <%= success[0] %>
      </span>
      <button type="button" class="alert-close" onclick="this.parentElement.remove()">
        &times;
      </button>
    </div>
    <% } %>

      <% if (error && error.length> 0) { %>
        <div id="errorAlert" class="custom-alert error-alert">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span>
            <%= error[0] %>
          </span>
          <button type="button" class="alert-close" onclick="this.parentElement.remove()">
            &times;
          </button>
        </div>
        <% } %>

          <div class="forgot-wrapper">

            <div class="forgot-card">
              <div class="icon-box">
                <i class="fa-solid fa-lock"></i>
              </div>

              <h2 class="login-title">Forgot Password?</h2>

              <p class="login-text">
                Enter your registered email address and we'll send you a password
                reset link.
              </p>

              <form action="/auth/forget-password/create" method="post">
                <div class="mb-4">
                  <label class="form-label">Email Address</label>

                  <input type="email" name="email" class="form-control" placeholder="Enter your email" />
                </div>

                <button type="submit" class="btn btn-primary w-100">
                  Send Reset Link
                </button>
              </form>

              <div class="back-login">
                <a href="/auth/login">
                  <i class="fa-solid fa-arrow-left"></i>
                  Back to Login
                </a>
              </div>
            </div>
          </div>

          <script src="../js/flash.js"></script>

</body>

</html>