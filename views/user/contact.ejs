<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="adminHMD professional admin dashboard template">
    <title>Dashboard | Abhaya</title>

    <link rel="stylesheet" href="../assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="../assets/css/style.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        body {
            background: #f8f9fc;
        }

        .page-title {
            font-weight: 700;
            color: #222;
        }

        .profile-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #ffe4e6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            color: #dc3545;
        }

        .icon-btn {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .info-box {
            background: #fff5f5;
            border-radius: 15px;
            border: 1px solid #ffd6d6;
        }

        .number-card {
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, .08);
            width: 95%;
        }

        .number-card i {
            font-size: 40px;
        }
    </style>

</head>

<body>
    <div class="admin-shell">
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <aside class="admin-sidebar" id="adminSidebar" aria-label="Main navigation">
            <div class="sidebar-header" style="display: flex; justify-content: center;">

        <div>
          <a class="brand-mark" href="/user/dashboard" aria-label="adminHMD dashboard">
            <img src="/img/core-img/abhaya-logo.png" alt="Abhaya Logo" style="height: 55px; width: 110px;">

          </a>
          <span class="brand-title">User Dashboard</span>
        </div>
      </div>
            <nav class="sidebar-nav">
                <a class="nav-link" href="/user/dashboard" aria-current="page">
                    <span class="nav-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
                    <span class="nav-text">Dashboard</span>
                </a>

                <a href="/user/profile" class="nav-link">
                    <span class="nav-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                    <span class="nav-text">Profile</span>
                </a>

                <a href="/user/location" class="nav-link">
                    <span class="nav-icon"><i class="fa-solid fa-location-dot"></i></span>
                    <span class="nav-text">Live Location</span>
                </a>

                <a href="/contact/all" class="nav-link active">
                    <span class="nav-icon"><i class="fas fa-address-book"></i></span>
                    <span class="nav-text">Emergency Contacts</span>
                </a>

                <a href="/report/view" class="nav-link">
                    <span class="nav-icon"><i class="fas fa-exclamation-circle"></i></span>
                    <span class="nav-text">Report Incident</span>
                </a>

                <a href="/sos/history" class="nav-link">
                    <span class="nav-icon"><i class="fas fa-history"></i></span>
                    <span class="nav-text">SOS History</span>
                </a>

                <a href="/user/safetytips" class="nav-link">
                    <span class="nav-icon"><i class="fas fa-user-shield"></i></span>
                    <span class="nav-text">Safety Tips</span>
                </a>

                </a>
                <a href="/user/settings" class="nav-link">
                    <span class="nav-icon"><i class="bi bi-gear" aria-hidden="true"></i></span>
                    <span class="nav-text">Settings</span>
                </a>

            </nav>

            <div class="sidebar-footer">
                <span class="status-dot"></span>
                <span class="sidebar-footer-text">System running smoothly</span>
            </div>
        </aside>

        <div class="admin-main">
            <nav class="navbar admin-navbar navbar-expand bg-white">
                <div class="container-fluid px-3 px-lg-4">
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="adminSidebar"
                        aria-expanded="true" aria-label="Toggle sidebar">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>

                    <form class="d-none d-md-flex ms-3 flex-grow-1" role="search">
                        <input class="form-control search-input" type="search"
                            placeholder="Search users, orders, reports" aria-label="Search">
                    </form>

                    <button id="sosBtn" class="btn btn-danger me-4">
                        Emergency SOS
                    </button>

                    <div class="navbar-actions ms-auto">
                        <button class="icon-button theme-toggle" type="button" data-theme-toggle
                            aria-label="Switch color theme" title="Switch color theme">
                            <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>
                        </button>
                        <div class="dropdown">
                            <div class="notification">
                                <button class="icon-button" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false" aria-label="Notifications">

                                    <i class="bi bi-bell" aria-hidden="true" id="bell"></i>
                                    <span id="count" class="notificationbadge">0</span>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end notification-menu" id="notificationBox">
                                    <div class="dropdown-header fw-bold text-body">Notifications</div>

                                </div>
                            </div>
                        </div>

                        <div class="dropdown">

                            <button class="profile-button dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false">
                                <!-- <img class="avatar-img avatar-sm" src="../assets/images/avatar/avatar.jpg" alt="Admin Hasan"> -->
                                <span class="d-none d-sm-inline">
                                    <%= userData.name %>
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/user/profile">Profile</a></li>
                                <li><a class="dropdown-item" href="/user/settings">Account settings</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="/auth/logout">Sign out</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <main class="dashboard-content">
                <div class="container-fluid px-3 px-lg-4 py-4">
                    <div class="page-heading">
                        <div class="page-heading-copy">
                            <span class="page-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>

                            <div>
                                <p class="eyebrow mb-1">Overview</p>
                                <h1 class="h3 mb-1">Contact</h1>
                                <p class="text-muted mb-0">Your personal safety hub for emergency assistance, live
                                    location sharing, and trusted contact management.</p>
                            </div>
                        </div>

                    </div>
                    <div class="container py-5">

                        <!-- Header -->

                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <div>
                                <h2 class="page-title">
                                    <i class="fa-solid fa-address-book text-danger"></i>
                                    Emergency Contacts
                                </h2>

                                <p class="text-muted">
                                    Manage trusted people for emergency situations.
                                </p>
                            </div>

                            <a href="/contact/add-view" class="btn btn-danger">
                                <i class="fa-solid fa-plus"></i>
                                Add Contact
                            </a>

                        </div>

                        <!-- Information -->

                        <div class="info-box p-4 mb-5">

                            <div class="d-flex">

                                <div class="me-3">
                                    <i class="fa-solid fa-shield-heart text-danger fs-1"></i>
                                </div>

                                <div>
                                    <h4 class="text-danger">
                                        SOS Alert
                                    </h4>

                                    <p class="mb-0">
                                        When you press the SOS button, all emergency contacts
                                        will receive your live location and alert message.
                                    </p>

                                </div>

                            </div>

                        </div>

                        <!-- Contact List -->

                        <h4 class="mb-4">
                            My Contacts
                        </h4>

                        <div class="card contact-card">
                            <% if(contact===null) { %>
                                <div class="no-data-card mt-3">

                                    <div class="no-data-icon">
                                        <i class="fa-solid fa-address-book"></i>
                                    </div>

                                    <h4>No Emergency Contacts Found</h4>

                                    <p>
                                        You haven't added any emergency contacts yet.
                                        Add a trusted person so they can be contacted during an emergency.
                                    </p>

                                    <a href="/contact/add-view" class="btn-add-contact">
                                        <i class="fa-solid fa-plus"></i>
                                        Add Emergency Contact
                                    </a>

                                </div>

                                <% } else { contact.contacts.forEach(element=> { %>

                                    <div class="card contact-card mb-4 mt-3">

                                        <div class="card-body">

                                            <div class="contact-content">

                                                <!-- Profile Icon -->
                                                <div class="profile-icon">
                                                    <i class="fa-solid fa-user"></i>
                                                </div>

                                                <!-- Contact Details -->
                                                <div class="contact-details">

                                                    <div class="contact-name">

                                                        <h5>
                                                            <%= element.name %>
                                                        </h5>

                                                        <% if(element.primary){ %>
                                                            <span class="primary-badge">
                                                                <i class="fa-solid fa-star"></i>
                                                                Primary
                                                            </span>
                                                            <% } %>

                                                    </div>

                                                    <div class="contact-phone">
                                                        <i class="fa-solid fa-phone"></i>
                                                        <span>
                                                            <%= element.phone %>
                                                        </span>
                                                    </div>

                                                    <div class="contact-relationship">
                                                        <i class="fa-solid fa-users"></i>
                                                        <span>
                                                            <%= element.relationship %>
                                                        </span>
                                                    </div>

                                                </div>

                                                <!-- Action Buttons -->


                                            </div>
                                            <!-- Bottom actions -->
                                            <div class="contact-card-actions">

                                                <a href="tel:<%= element.phone %>" class="action-btn call"
                                                    title="Call Contact">

                                                    <i class="fa-solid fa-phone"></i>
                                                    <span>Call</span>

                                                </a>


                                                <a href="sms:<%= element.phone %>" class="action-btn message"
                                                    title="Send Message">

                                                    <i class="fa-solid fa-comment"></i>
                                                    <span>Message</span>

                                                </a>

                                            </div>
                                        </div>

                                    </div>
                                    <% }) %>

                                        <% } %>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="d-flex justify-content-end gap-2">

                            <div class="dropdown">

                                <ul class="dropdown-menu">

                                    <li>

                                        Edit

                                        </a>
                                    </li>

                                    <li>

                                        <i class="fa-solid fa-trash"></i>
                                        Delete

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Emergency Numbers -->

                <h4 class="mb-4 ms-4">
                    Important Emergency Numbers
                </h4>

                <div class="row ms-3 mb-5 pt-2" style="margin-left: 100px;">
                   

                    <div class="col-lg-4">

                        <div class="number-card p-4 text-center">

                            <i class="fa-solid fa-shield text-primary"></i>

                            <h4 class="mt-3">Police</h4>

                            <h2>100</h2>

                            <a href="tel:100" class="btn btn-outline-primary mt-2">
                                Call Now
                            </a>

                        </div>

                    </div>

                    <div class="col-lg-4">

                        <div class="number-card p-4 text-center">

                            <i class="fa-solid fa-truck-medical text-danger"></i>

                            <h4 class="mt-3">Ambulance</h4>

                            <h2>108</h2>

                            <a href="tel:108" class="btn btn-outline-danger mt-2">
                                Call Now
                            </a>

                        </div>

                    </div>

                    <div class="col-lg-4">

                        <div class="number-card p-4 text-center">

                            <i class="fa-solid fa-fire text-warning"></i>

                            <h4 class="mt-3">Fire Service</h4>

                            <h2>101</h2>

                            <a href="tel:101" class="btn btn-outline-warning mt-2">
                                Call Now
                            </a>

                        </div>

                    </div>

                </div>
            </main>

            <footer class="d-flex justify-content-between align-items-center px-4 py-3 mt-2 mb-2">
            <div>
                Copyright © 2026 User
                <a href="#" class="fw-bold text-success text-decoration-none">
                    Abhaya
                </a>
            </div>

            <div>
                Professional dashboard template.
            </div>
        </footer>

        </div>
    </div>

    <script>

        document.getElementById("sosBtn").addEventListener("click", () => {

            if (!navigator.geolocation) {
                alert("Geolocation is not supported by your browser.");
                return;
            }

            navigator.geolocation.getCurrentPosition(

                async (position) => {

                    const latitude = position.coords.latitude;
                    const longitude = position.coords.longitude;

                    // console.log("Latitude:", latitude);
                    // console.log("Longitude:", longitude);

                    try {

                        const response = await fetch("/sos/send", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                latitude,
                                longitude
                            })
                        });

                        const data = await response.json();
                        const btn = document.getElementById("sosBtn");

                        alert(data.message);

                    } catch (err) {
                        console.error(err);
                        alert("Failed to send SOS.");
                    }

                },

                (error) => {

                    console.error(error);

                    switch (error.code) {
                        case error.PERMISSION_DENIED:
                            alert("Location permission denied.");
                            break;

                        case error.POSITION_UNAVAILABLE:
                            alert("Location unavailable.");
                            break;

                        case error.TIMEOUT:
                            alert("Location request timed out.");
                            break;

                        default:
                            alert("Unable to get location.");
                    }
                }

            );

        });

    </script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="../assets/js/bootstrap.bundle.min.js"></script>
    <script src="../assets/js/main.js"></script>
</body>

</html>