<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>User - Login | Abhaya</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="../assets/css/login.css">

    <link rel="stylesheet" href="../css/flash.css">
</head>

<body>

    <div class="login-wrapper">
        <% if (success && success.length> 0) { %>
            <div id="successAlert" class="custom-alert success-alert">
                <i class="fa-solid fa-circle-check"></i>
                <span>
                    <%= success[0] %>
                </span>
                <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                    &times;
                </button>
            </div>
            <% } %>

                <% if (error && error.length> 0) { %>
                    <div id="errorAlert" class="custom-alert error-alert">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>
                            <%= error[0] %>
                        </span>
                        <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                            &times;
                        </button>
                    </div>
                    <% } %>
                        <!-- ================= LEFT SIDE ================= -->

                        <div class="login-info">

                            <h2>
                                Your Safety,
                                <span>Our Priority.</span>
                            </h2>

                            <div class="safety-line"></div>

                            <p>
                                Abhaya is here to protect, empower and support you
                                every step of the way. Stay connected with the people
                                and services that keep you safe.
                            </p>

                            <!-- Features -->

                            <div class="features">

                                <div class="feature">

                                    <i class="fa-solid fa-shield-heart"></i>

                                    <strong>One Tap SOS</strong>

                                    <small>
                                        Instant Emergency Alerts
                                    </small>

                                </div>

                                <div class="feature">

                                    <i class="fa-solid fa-location-dot"></i>

                                    <strong>Live Location</strong>

                                    <small>
                                        Share your location
                                    </small>

                                </div>


                                <div class="feature">

                                    <i class="fa-solid fa-user-group"></i>

                                    <strong>Trusted Support</strong>

                                    <small>
                                        We're always with you
                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- ================= RIGHT SIDE ================= -->

                        <div class="login-form-area">

                            <h1>Welcome Back!</h1>

                            <p class="login-subtitle">
                                Login to continue to your Abhaya account
                            </p>


                            <!-- Login Form -->

                            <form action="/auth/login/create" method="POST">

                                <!-- Email -->

                                <div class="input-box">

                                    <i class="fa-regular fa-envelope"></i>

                                    <input type="email" name="email" placeholder="Enter Email Address..." required>

                                </div>


                                <!-- Password -->

                                <div class="input-box">

                                    <i class="fa-solid fa-lock"></i>

                                    <input type="password" name="password" id="password" placeholder="Password"
                                        required>
                                    <i class="fa-solid fa-eye password-eye" id="eyeIcon" onclick="togglePassword()"></i>

                                </div>

                                <!-- Login -->

                                <button type="submit" class="login-btn">

                                    Login
                                    <i class="fa-solid fa-arrow-right"></i>

                                </button>

                            </form>


                            <!-- Divider -->

                            <div class="divider">
                                or
                            </div>


                            <!-- Google -->

                            <!-- <a href="/auth/google" class="btn btn-facebook btn-user btn-block" style="border-radius: 30px;"> <button
                    type="button" class="google-btn">

                    <i class="fa-brands fa-google"></i>

                    Login with Google

                </button>

            </a> -->

                            <!-- Links -->

                            <div class="login-links">

                                <a href="/auth/forget-password/view">
                                    <i class="fa-solid fa-lock"></i>
                                    Forgot Password?
                                </a>

                                <a href="/auth/register">
                                    <i class="fa-solid fa-user-plus"></i>
                                    Create an Account!
                                </a>

                            </div>


                            <!-- Emergency -->

                            <div class="emergency-box">

                                <div class="emergency-icon">

                                    <i class="fa-solid fa-shield-halved"></i>

                                </div>

                                <div>

                                    <strong>
                                        In Emergency?
                                    </strong>

                                    <p>
                                        Don't wait. Use the SOS button
                                        to alert your emergency contacts.
                                    </p>

                                </div>

                                <a href="#" class="sos-btn">

                                    Send SOS
                                    <i class="fa-solid fa-bell"></i>

                                </a>

                            </div>

                        </div>

    </div>

    <script>
        function googleLogin() {
            window.location.href = "/auth/google";
        }
    </script>

    <script src="../js/password.js"></script>

    <script src="../js/flash.js"></script>

    <%- include('../common/script') %>

</body>

</html>