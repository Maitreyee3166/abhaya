<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>User - Register | Abhaya</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="../assets/css/login.css">

    <link rel="stylesheet" href="../css/flash.css">

    <style>
        .success-icon {
            font-size: 60px;
            color: #08bfbf;
        }

        .modal-content {
            border: none;
            border-radius: 15px;
        }

        .pending-box {
            background-color: #f5fafa;
            padding: 15px;
            border-radius: 10px;
            margin-top: 20px;
        }

        .pending-box>i {
            font-size: 25px;
            color: #f0ad4e;
            margin-bottom: 8px;
        }

        .pending-box h5 {
            color: #1a2f4b;
        }

        .pending-box p {
            color: #666;
            margin-bottom: 0;
            line-height: 1.5;
        }
    </style>
</head>

<body class="bg-gradient-primary">

    <div class="login-wrapper">
        <% if (success && success.length> 0) { %>
            <div id="successAlert" class="custom-alert success-alert">
                <i class="fa-solid fa-circle-check"></i>
                <span>
                    <%= success[0] %>
                </span>
                <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                    &times;
                </button>
            </div>
            <% } %>

                <% if (error && error.length> 0) { %>
                    <div id="errorAlert" class="custom-alert error-alert">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>
                            <%= error[0] %>
                        </span>
                        <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                            &times;
                        </button>
                    </div>
                    <% } %>

                        <!-- ================= LEFT SIDE ================= -->

                        <div class="login-info">

                            <h2>
                                Your Safety,
                                <span>Our Priority.</span>
                            </h2>

                            <div class="safety-line"></div>

                            <p>
                                Abhaya is here to protect, empower and support you
                                every step of the way. Stay connected with the people
                                and services that keep you safe.
                            </p>


                            <!-- Features -->

                            <div class="features">

                                <div class="feature">

                                    <i class="fa-solid fa-shield-heart"></i>

                                    <strong>One Tap SOS</strong>

                                    <small>
                                        Instant Emergency Alerts
                                    </small>

                                </div>

                                <div class="feature">

                                    <i class="fa-solid fa-location-dot"></i>

                                    <strong>Live Location</strong>

                                    <small>
                                        Share your location
                                    </small>

                                </div>

                                <div class="feature">

                                    <i class="fa-solid fa-user-group"></i>

                                    <strong>Trusted Support</strong>

                                    <small>
                                        We're always with you
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- ================= RIGHT SIDE ================= -->

                        <div class="login-form-area">

                            <h1 class="h4 text-gray-900 mb-4">Create an Account!</h1>
                            <!-- </div> -->
                            <form class="user" action="/auth/register/create" method="post"
                                enctype="multipart/form-data">

                                <div class="form-group mb-2">
                                    <input type="text" class="form-control form-control-user" id="exampleFirstName"
                                        name="fullName" placeholder="Enter Your Full Name">
                                </div>

                                <div class="form-group mb-2">
                                    <input type="email" class="form-control form-control-user" id="exampleInputEmail"
                                        name="email" placeholder="Email Address">
                                </div>

                                <div class="form-group mb-2">
                                    <input type="text" class="form-control form-control-user" name="phone"
                                        id="exampleInputPassword" placeholder="Phone Number">
                                </div>

                                <div class="form-group mb-2">
                                    <div class="password-wrapper">
                                        <input type="password" class="form-control form-control-user" name="password"
                                            id="password" placeholder="Password">

                                        <i class="fa-solid fa-eye password-eye" id="eyeIcon"
                                            onclick="togglePassword()"></i>
                                    </div>
                                </div>
                                <div class="form-group mb-2">
                                    <input type="date" class="form-control form-control-user" name="dob"
                                        id="exampleInputPassword" placeholder="Date of Birth">
                                </div>

                                <div class="form-group mb-2">
                                    <input type="file" class="form-control form-control-user" id="image" name="image"
                                        placeholder="Product image">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Gender</label><br>

                                    <input type="radio" id="female" name="gender" value="female" required>
                                    <label for="female">Female</label>

                                    &nbsp;&nbsp;&nbsp;

                                    <input type="radio" id="male" name="gender" value="male">
                                    <label for="male">Male</label>

                                    &nbsp;&nbsp;&nbsp;

                                    <input type="radio" id="other" name="gender" value="other">
                                    <label for="other">Other</label>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">state</label>
                                    <input type="text" class="form-control" name="state" placeholder="Enter state"
                                        required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">district</label>
                                    <input type="text" class="form-control" name="district" placeholder="Enter district"
                                        required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">City</label>
                                    <input type="text" class="form-control" name="city" placeholder="Enter City"
                                        required>
                                </div>

                                <button type="submit" class="login-btn">
                                    <i class="fa-solid fa-arrow-right"></i>
                                    Register Account
                                </button>
                            </form>

                            <hr>

                            <div class="text-center">
                                <a class="small" href="/auth/login">Already have an account? Login!</a>
                            </div>
                            <div class="text-center">
                                <a class="small" href="/auth/login">Are you admin? Login!</a>
                            </div>
                        </div>

    </div>

    <!-- Registration Success Modal -->
    <div class="modal fade" id="registrationSuccessModal" tabindex="-1" aria-labelledby="registrationSuccessModalLabel"
        aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center">

                <div class="modal-body p-4">

                    <div class="success-icon mb-3">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <h3 id="registrationSuccessModalLabel">
                        Registration Successful!
                    </h3>

                    <p class="mt-3">
                        Your account has been successfully created.
                    </p>

                    <div class="pending-box">
                        <i class="fa-solid fa-clock"></i>

                        <h5>Waiting for Admin Verification</h5>

                        <p>
                            Your account is currently waiting for admin
                            verification. You will be able to login once
                            an administrator approves your account.
                        </p>
                    </div>

                    <a href="/auth/woman-safety" class="btn btn-primary mt-3">
                        <i class="fa-solid fa-house"></i>
                        Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>

    <% if (success && success.length> 0) { %>

        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const modalElement = document.getElementById(
                    "registrationSuccessModal"
                );

                const modal = new bootstrap.Modal(modalElement);

                modal.show();
            });
        </script>

        <% } %>

            <!-- Bootstrap JS -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

            <script src="../js/password.js"></script>

            <script src="../js/flash.js"></script>

            <%- include('../common/script') %>

</body>

</html>