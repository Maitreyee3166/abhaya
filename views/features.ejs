    <section class="ve-section">
        <div class="container">
            <div class="ve-section-header text-center">
                <span class="ve-section-tag">Our Expertise</span>
                <h2>Solutions for Every <span>Safety Need</span></h2>
                <p>
                    From emergency assistance to incident reporting, Abhaya provides
                    practical safety solutions designed to protect, support, and empower women.
                </p>
            </div>

            <div class="ve-services-grid">

                <!-- Emergency SOS -->
                <div class="ve-service-card wow fadeInUp" data-wow-delay="100ms">
                    <div class="ve-service-icon">
                        <i class="fa fa-bell"></i>
                    </div>
                    <h4>Emergency SOS</h4>
                    <p>
                        Send an instant SOS alert during an emergency and quickly notify
                        trusted contacts or emergency responders.
                    </p>
                    <a href="#" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

                <!-- Live Location -->
                <div class="ve-service-card wow fadeInUp" data-wow-delay="200ms">
                    <div class="ve-service-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <h4>Live Location Sharing</h4>
                    <p>
                        Share your real-time location with trusted contacts so they can
                        know where you are when you need assistance.
                    </p>
                    <a href="#" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

                <!-- Emergency Contacts -->
                <div class="ve-service-card wow fadeInUp" data-wow-delay="300ms">
                    <div class="ve-service-icon">
                        <i class="fa fa-users"></i>
                    </div>
                    <h4>Emergency Contacts</h4>
                    <p>
                        Manage trusted family members, friends, guardians, and other
                        emergency contacts for quick communication during critical situations.
                    </p>
                    <a href="#" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

                <!-- Incident Reporting -->
                <div class="ve-service-card wow fadeInUp" data-wow-delay="400ms">
                    <div class="ve-service-icon">
                        <i class="fa fa-file-text"></i>
                    </div>
                    <h4>Incident Reporting</h4>
                    <p>
                        Report incidents such as harassment, stalking, abuse, threats,
                        and cybercrime with relevant details and evidence.
                    </p>
                    <a href="#" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

                <div class="ve-service-card wow fadeInUp" data-wow-delay="600ms">
                    <div class="ve-service-icon"><i class="fa fa-life-ring"></i></div>
                    <h4>24/7 Support</h4>
                    <p>Get continuous assistance whenever you need help from our safety support network.</p>
                    <a href="#" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

                <!-- Safety Support -->
                <div class="ve-service-card wow fadeInUp" data-wow-delay="600ms">
                    <div class="ve-service-icon">
                        <i class="fa-solid fa-shield-heart"></i>
                    </div>
                    <h4>Safety Support</h4>
                    <p>
                        Access helpful safety information and support resources to make
                        informed decisions and respond effectively to unsafe situations.
                    </p>
                    <a href="#" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

