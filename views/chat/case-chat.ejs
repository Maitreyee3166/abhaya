<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Case Chat</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Socket.IO -->
    <script src="/socket.io/socket.io.js"></script>

    <style>
        body {
            
            background: linear-gradient(135deg, #e3ebf8, #cfe1f8);
            font-family: Arial, sans-serif;
            height: 100vh;
        }

        .chat-container {
            max-width: 900px;
            height: 90vh;
            margin: 30px auto;
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Header */
        .chat-header {
            background: #1a2f4b;
            color: white;
            padding: 18px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .chat-header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chat-header-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #fff;
            color: #1a2f4b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .chat-header h5 {
            margin: 0;
        }

        .chat-header small {
            opacity: 0.8;
        }

        .case-status {
            background: #198754;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
        }

        /* Messages */
        .chat-messages {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            background: #f8f9fa;
        }

        .message-row {
            display: flex;
            margin-bottom: 15px;
        }

        .message-row.mine {
            justify-content: flex-end;
        }

        .message {
            max-width: 70%;
            padding: 10px 14px;
            border-radius: 14px;
            position: relative;
        }

        .message.other {
            background: white;
            border: 1px solid #e5e5e5;
            border-bottom-left-radius: 3px;
        }

        .message.mine {
            background: #1a2f4b;
            color: white;
            border-bottom-right-radius: 3px;
        }

        .sender-name {
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 4px;
        }

        .message-text {
            font-size: 14px;
            word-wrap: break-word;
        }

        .message-time {
            font-size: 10px;
            opacity: 0.65;
            text-align: right;
            margin-top: 5px;
        }

        /* Role badges */
        .role-badge {
            font-size: 10px;
            padding: 2px 7px;
            border-radius: 10px;
            margin-left: 5px;
        }

        .role-victim {
            background: #ffe5e5;
            color: #dc3545;
        }

        .role-admin {
            background: #e7f1ff;
            color: #0d6efd;
        }

        .role-police {
            background: #e7f7ef;
            color: #198754;
        }

        /* Input */
        .chat-input-area {
            padding: 15px;
            background: white;
            border-top: 1px solid #ddd;
        }

        .chat-input {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .chat-input input {
            flex: 1;
            border: 1px solid #ddd;
            border-radius: 25px;
            padding: 12px 18px;
            outline: none;
        }

        .chat-input input:focus {
            border-color: #1a2f4b;
            box-shadow: 0 0 0 2px rgba(26, 47, 75, 0.1);
        }

        .send-btn {
            width: 45px;
            height: 45px;
            border: none;
            border-radius: 50%;
            background: #1a2f4b;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .send-btn:hover {
            background: #243f61;
        }

        .empty-chat {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #888;
            text-align: center;
        }

        .empty-chat i {
            font-size: 45px;
            margin-bottom: 10px;
            color: #aaa;
        }

        @media (max-width: 600px) {
            .chat-container {
                height: 100vh;
                margin: 0;
                border-radius: 0;
            }

            .message {
                max-width: 85%;
            }

            .case-status {
                display: none;
            }
        }

        
    </style>
</head>

<body>

    <div class="chat-container">

        <!-- ================= HEADER ================= -->
        <div class="chat-header">

            <div class="chat-header-left">

                <div class="chat-header-icon">
                    <i class="fa-solid fa-comments"></i>
                </div>

                <div>
                    <h5>Abhaya Case Chat</h5>

                    <small>
                        Case ID:
                        <%= caseId %>
                    </small>
                </div>

            </div>

            <div>
                <span class="case-status">
                    <i class="fa-solid fa-circle" style="font-size: 8px;"></i>
                    Active
                </span>
            </div>

        </div>


        <!-- ================= MESSAGES ================= -->
        <div class="chat-messages" id="chatMessages">

            <div class="empty-chat" id="emptyChat">

                <div>
                    <i class="fa-regular fa-comments"></i>

                    <p class="mb-0">
                        No messages yet.
                    </p>

                    <small>
                        Start the conversation.
                    </small>
                </div>

            </div>

        </div>


        <!-- ================= INPUT ================= -->
        <div class="chat-input-area">

            <form id="chatForm">

                <div class="chat-input">

                    <input type="text" id="messageInput" placeholder="Type your message..." autocomplete="off"
                        maxlength="1000" required>

                    <button type="submit" class="send-btn" title="Send Message">

                        <i class="fa-solid fa-paper-plane"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

    <script>

        const socket = io();

        const caseId = "<%= caseId %>";
        const currentUserId = "<%= userId %>";
        const currentRole = "<%= role %>";

    
        // console.log( "current role:" , currentRole );

        socket.emit("joinCaseChat", {
            caseId: caseId,
            userId: currentUserId,
            role: currentRole
        });

        const chatForm = document.getElementById("chatForm");

        const messageInput =
            document.getElementById("messageInput");

        const chatMessages =
            document.getElementById("chatMessages");

        const emptyChat =
            document.getElementById("emptyChat");


        chatForm.addEventListener("submit", function (e) {

            e.preventDefault();

            const message =
                messageInput.value.trim();

            if (!message) {
                return;
            }

            socket.emit("sendCaseMessage", {

                caseId: caseId,

                senderId: currentUserId,

                senderModel: currentRole,

                message: message

            });

            messageInput.value = "";

            messageInput.focus();

        });

        socket.on("newCaseMessage", function (data) {

            addMessage(data);

        });

        function addMessage(data) {

            if (emptyChat) {
                emptyChat.style.display = "none";
            }

            const messageRow =
                document.createElement("div");

            const isMine =
                String(data.senderId) ===
                String(currentUserId);

            messageRow.classList.add("message-row");

            if (isMine) {
                messageRow.classList.add("mine");
            }


            const messageDiv =
                document.createElement("div");

            messageDiv.classList.add("message");

            if (isMine) {
                messageDiv.classList.add("mine");
            } else {
                messageDiv.classList.add("other");
            }


            // Sender role
            // if(roleName === 'user'){
            //     data.senderModel === 'Victim'
            // } else {
            let roleName =
                data.senderModel || "User";
            // }

            roleName =
                roleName.charAt(0).toUpperCase() +
                roleName.slice(1);


            let roleClass = "role-victim";

            if (data.senderModel === "admin") {
                roleClass = "role-admin";
            }

            if (data.senderModel === "police") {
                roleClass = "role-police";
            }


            // Time
            let time = "";

            if (data.createdAt) {

                const date =
                    new Date(data.createdAt);

                time =
                    date.toLocaleTimeString([], {
                        hour: "2-digit",
                        minute: "2-digit"
                    });

            } else {

                time =
                    new Date().toLocaleTimeString([], {
                        hour: "2-digit",
                        minute: "2-digit"
                    });
            }

            messageDiv.innerHTML = `

                ${!isMine ? `
                    <div class="sender-name">

                        ${roleName}

                        <span class="role-badge ${roleClass}">
                            ${roleName}
                        </span>

                    </div>
                ` : ""}

                <div class="message-text">
                    ${escapeHtml(data.message)}
                </div>

                <div class="message-time">
                    ${time}
                </div>

            `;


            messageRow.appendChild(messageDiv);

            chatMessages.appendChild(messageRow);


            // Scroll to bottom
            chatMessages.scrollTop =
                chatMessages.scrollHeight;

        }


        async function loadMessages() {

            try {

                const response =
                    await fetch(`/chat/messages/${caseId}`);

                const result =
                    await response.json();

                if (!result.success) {
                    return;
                }

                chatMessages.innerHTML = "";

                if (!result.messages ||
                    result.messages.length === 0) {

                    chatMessages.appendChild(emptyChat);

                    emptyChat.style.display = "flex";

                    return;
                }

                result.messages.forEach(message => {

                    addMessage(message);

                });

            } catch (error) {

                console.error(
                    "Failed to load messages:",
                    error
                );

            }

        }


        // Load previous messages
        loadMessages();


        function escapeHtml(text) {

            const div =
                document.createElement("div");

            div.textContent = text;

            return div.innerHTML;

        }


        socket.on("chatError", function (data) {

            alert(
                data.message ||
                "Unable to send message."
            );

        });

    </script>

</body>

</html>