<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="adminHMD professional admin dashboard template">
    <title>Dashboard | Abhaya</title>

    <link rel="stylesheet" href="../assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="../assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="../assets/css/style.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">

    <script src="/socket.io/socket.io.js"></script>

    <link rel="stylesheet" href="../css/flash.css">

</head>

<body>
    <div class="admin-shell">
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <aside class="admin-sidebar" id="adminSidebar" aria-label="Main navigation">
            <div class="sidebar-header" style="display: flex; justify-content: center;">

                <div>
                    <a class="brand-mark" href="/user/dashboard" aria-label="adminHMD dashboard">
                        <img src="/img/core-img/abhaya-logo.png" alt="Abhaya Logo" style="height: 55px; width: 120px;">

                    </a>
                    <span class="brand-title">Admin Dashboard</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link" href="/admin/dashboard" aria-current="page">
                    <span class="nav-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
                    <span class="nav-text">Dashboard</span>
                </a>

                <a href="/user/profile" class="nav-link">
                    <span class="nav-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                    <span class="nav-text">Profile</span>
                </a>

                <a href="/sos/all" class="nav-link active">
                    <span class="nav-icon"><i class="fas fa-history"></i></span>
                    <span class="nav-text">SOS Alerts</span>
                </a>

                <a href="/user/all" class="nav-link">
                    <span class="nav-icon"><i class="fa-solid fa-location-dot"></i></span>
                    <span class="nav-text">Users</span>
                </a>

                <a href="/police/all" class="nav-link">
                    <span class="nav-icon"><i class="fas fa-address-book"></i></span>
                    <span class="nav-text">Police Contacts</span>
                </a>

                <a href="/report/all" class="nav-link">
                    <span class="nav-icon"><i class="fas fa-exclamation-circle"></i></span>
                    <span class="nav-text">Incident Report</span>
                </a>

                <a href="/user/safetytips" class="nav-link">
                    <span class="nav-icon"><i class="fas fa-user-shield"></i></span>
                    <span class="nav-text">Safety Tips</span>
                </a>

                </a>
                <a href="/user/settings" class="nav-link">
                    <span class="nav-icon"><i class="bi bi-gear" aria-hidden="true"></i></span>
                    <span class="nav-text">Settings</span>
                </a>

            </nav>

            <div class="sidebar-footer">
                <span class="status-dot"></span>
                <span class="sidebar-footer-text">System running smoothly</span>
            </div>
        </aside>

        <div class="admin-main">
            <nav class="navbar admin-navbar navbar-expand bg-white">
                <div class="container-fluid px-3 px-lg-4">
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="adminSidebar"
                        aria-expanded="true" aria-label="Toggle sidebar">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>

                    <form class="d-none d-md-flex ms-3 flex-grow-1" role="search">
                        <input class="form-control search-input" type="search"
                            placeholder="Search users, orders, reports" aria-label="Search">
                    </form>

                    <!-- <button id="sosBtn" class="btn btn-danger me-4">
            Emergency SOS
          </button> -->

                    <div class="navbar-actions ms-auto">
                        <button class="icon-button theme-toggle" type="button" data-theme-toggle
                            aria-label="Switch color theme" title="Switch color theme">
                            <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>
                        </button>
                        <div class="dropdown">
                            <div class="notification">
                                <button class="icon-button" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false" aria-label="Notifications">

                                    <i class="bi bi-bell" aria-hidden="true" id="bell"></i>
                                    <span id="count" class="notificationbadge">0</span>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end notification-menu" id="notificationBox">
                                    <div class="dropdown-header fw-bold text-body">Notifications</div>

                                </div>
                            </div>
                        </div>
                        <div class="dropdown">

                            <button class="profile-button dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false">
                                <!-- <img class="avatar-img avatar-sm" src="../assets/images/avatar/avatar.jpg" alt="Admin Hasan"> -->
                                <span class="d-none d-sm-inline">
                                    <%= userData.name %>
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/user/profile">Profile</a></li>
                                <li><a class="dropdown-item" href="/user/settings">Account settings</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="/auth/logout">Sign out</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <% if (success && success.length> 0) { %>
                <div id="successAlert" class="custom-alert success-alert">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>
                        <%= success[0] %>
                    </span>
                    <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                        &times;
                    </button>
                </div>
                <% } %>

                    <% if (error && error.length> 0) { %>
                        <div id="errorAlert" class="custom-alert error-alert">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <span>
                                <%= error[0] %>
                            </span>
                            <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                                &times;
                            </button>
                        </div>
                        <% } %>

                            <main class="dashboard-content">
                                <div class="container-fluid px-3 px-lg-4 py-4">
                                    <div class="page-heading">
                                        <div class="page-heading-copy">
                                            <span class="page-icon"><i class="bi bi-speedometer2"
                                                    aria-hidden="true"></i></span>
                                            <div>
                                                <p class="eyebrow mb-1">Overview</p>
                                                <h1 class="h3 mb-1">Dashboard</h1>
                                                <p class="text-muted mb-0">Empowering women's safety through real-time
                                                    monitoring, user
                                                    verification,
                                                    and emergency response management.</p>
                                            </div>
                                        </div>
                                    </div>

                                    <section class="m-5">
                                        <div class="row g-4">

                                            <!-- SOS -->
                                            <div class="col-lg-12">

                                                <div
                                                    class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                                                    <h4 class="fw-bold mb-0 p-3">Active SOS Alert</h4>

                                                    <% if(activeSOS && activeSOS.length> 0){ %>
                                                        <span class="badge bg-danger m-3 p-2">LIVE</span>
                                                        <% } %>
                                                </div>

                                                <div class="card-body p-4 bg-white rounded-4">

                                                    <% if(activeSOS && activeSOS.length> 0){
                                                        activeSOS.forEach(sos=> { %>

                                                        <div class="row">

                                                            <!-- Left Side -->
                                                            <div class="col-lg-6 border-end">

                                                                <div class="d-flex align-items-center mb-4">

                                                                    <img src="<%= sos.user.image %>"
                                                                        class="rounded-circle me-3" width="60"
                                                                        height="60">

                                                                    <div>
                                                                        <h5 class="mb-1 mt-2">
                                                                            <%= sos.user.fullName %>
                                                                        </h5>

                                                                        <div class="text-muted mt-2">
                                                                            <i class="fa-solid fa-phone"></i>
                                                                            <%= sos.user.phone %>
                                                                        </div>

                                                                        <% const birthDate=new Date(sos.user.dob); const
                                                                            today=new Date(); let
                                                                            age=today.getFullYear() -
                                                                            birthDate.getFullYear(); const
                                                                            monthDiff=today.getMonth() -
                                                                            birthDate.getMonth(); if (monthDiff < 0 ||
                                                                            (monthDiff===0 && today.getDate() <
                                                                            birthDate.getDate())) { age--; } %>

                                                                            <div class="text-muted mt-2">
                                                                                <i class="fa-solid fa-user"></i>
                                                                                <%= sos.user.gender %>,
                                                                                    <%= age %> years old
                                                                            </div>
                                                                    </div>

                                                                </div>

                                                                <div class="mb-3">
                                                                    <h6>
                                                                        <i
                                                                            class="fa-solid fa-location-dot text-secondary"></i>
                                                                        Location
                                                                    </h6>

                                                                    <p id="locationName">Loading location...</p>

                                                                    <script>

                                                                        const latitude = "<%= sos.location.coordinates[1] %>";
                                                                        const longitude = "<%= sos.location.coordinates[0] %>";

                                                                        fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}`)
                                                                            .then(res => res.json())
                                                                            .then(data => {
                                                                                document.getElementById("locationName").textContent = data.display_name;
                                                                            })
                                                                            .catch(() => {
                                                                                document.getElementById("locationName").textContent = "Location not available";
                                                                            });
                                                                    </script>

                                                                </div>

                                                                <div class="mb-3">
                                                                    <h6>
                                                                        <i
                                                                            class="fa-regular fa-clock text-secondary"></i>
                                                                        Time
                                                                    </h6>

                                                                    <p class="text-muted">
                                                                        <%= new Date(sos.createdAt).toLocaleString() %>
                                                                    </p>
                                                                </div>

                                                                <div class="mb-4">
                                                                    <strong>Status</strong>

                                                                    <span class="badge bg-danger ms-2">
                                                                        New
                                                                    </span>
                                                                </div>

                                                                <div class="d-flex gap-2 ms-2 me-2 mt-5">

                                                                    <!-- Call User -->
                                                                    <a href="tel:<%= sos.phone %>" class="w-100">
                                                                        <button type="button"
                                                                            class="btn btn-info w-100">
                                                                            <i class="fa-solid fa-phone"></i>
                                                                            Call User
                                                                        </button>
                                                                    </a>

                                                                    <!-- Assign Police -->
                                                                    <button type="button" class="btn btn-primary w-100"
                                                                        onclick="openAssignModal('<%= sos._id %>')">

                                                                        <i class="fa-solid fa-user-plus"></i>
                                                                        Assign Police

                                                                    </button>


                                                                    <!-- Resolve SOS -->
                                                                    <a href="/sos/resolve/<%= sos._id %>" class="w-100">
                                                                        <button type="button"
                                                                            class="btn btn-success w-100">

                                                                            <i class="fa-solid fa-check"></i>
                                                                            Resolved

                                                                        </button>
                                                                    </a>

                                                                </div>

                                                                <div class="ms-2 me-2 mt-4 w-100">
                                                                    <% sosCases.forEach(sosCase=> { %>
                                                                        <a href="/chat/case/<%= sosCase._id %>"
                                                                            class="btn text-light"
                                                                            style="width: 498px; background-color: rgb(4, 127, 198);">
                                                                            <i class="fa-regular fa-comments"></i> SOS
                                                                            Chat
                                                                        </a>
                                                                        <% }) %>
                                                                </div>

                                                            </div>

                                                            <!-- Map -->

                                                            <div class="col-lg-6 text-center">

                                                                <iframe width="100%" height="390"
                                                                    style="border-radius:15px;border:none;"
                                                                    loading="lazy"
                                                                    src="https://maps.google.com/maps?q=<%= sos.location.coordinates[1] %>,<%= sos.location.coordinates[0] %>&z=15&output=embed">
                                                                </iframe>

                                                                <a href="https://www.google.com/maps?q=<%= sos.location.coordinates[1] %>,<%= sos.location.coordinates[0] %>"
                                                                    target="_blank" class="btn btn-primary mt-3">

                                                                    <i class="fa-solid fa-map"></i>

                                                                    Open in Google Maps

                                                                </a>

                                                            </div>

                                                        </div>

                                                        <% })}else{ %>

                                                            <!-- Empty State -->

                                                            <div class="text-center py-5">

                                                                <img src="/img/core-img/no-alert.png" width="160"
                                                                    class="mb-3">

                                                                <h3 class="fw-bold text-success">
                                                                    No Active SOS Alerts
                                                                </h3>

                                                                <p class="text-muted">

                                                                    There are currently no emergency cases assigned to
                                                                    your police station.

                                                                </p>

                                                                <p class="text-muted">

                                                                    You'll receive an instant notification whenever a
                                                                    new
                                                                    SOS request is reported.

                                                                </p>

                                                                <a href="/sos/all" class="btn btn-outline-primary">

                                                                    View SOS History

                                                                </a>

                                                            </div>

                                                            <% } %>



                                                </div>
                                            </div>
                                        </div>
                                    </section>

                                    <% if (sosCases.status !=="Resolved" ) { sosCases.forEach(sosCase=> { %>

                                        <div class="card mb-5">
                                            <div
                                                style="display: flex; justify-content: space-between; margin-bottom: 10px;">

                                                <h6 class="m-3 mb-4">
                                                    Assigned Officers :
                                                    <span class="text-muted">
                                                        <%= sosCase.assignedOfficers ? sosCase.assignedOfficers.length :
                                                            0 %>
                                                    </span>
                                                </h6>

                                                <h6 class="m-3 mb-4">
                                                    Case Id :
                                                    <span class="text-muted">
                                                        <%= sosCase._id %>
                                                    </span>
                                                </h6>
                                            </div>

                                            <table>
                                                <thead>
                                                    <tr>
                                                        <th class="ps-3">Full Name</th>
                                                        <th>Phone No</th>
                                                        <th>Email</th>
                                                        <th>Police Station Name</th>
                                                        <th>City</th>
                                                        <th>District</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    <% if (sosCase.assignedOfficers && sosCase.assignedOfficers.length>
                                                        0) { %>

                                                        <% sosCase.assignedOfficers.forEach(officer=> { %>

                                                            <tr>
                                                                <td class="ps-3 pt-3 pb-3">
                                                                    <%= officer.fullName %>
                                                                </td>
                                                                <td>
                                                                    <%= officer.phone || 'N/A' %>
                                                                </td>
                                                                <td>
                                                                    <%= officer.email %>
                                                                </td>
                                                                <td>
                                                                    <%= officer.stationName %>
                                                                </td>
                                                                <td>
                                                                    <%= officer.city %>
                                                                </td>
                                                                <td>
                                                                    <%= officer.district %>
                                                                </td>
                                                            </tr>

                                                            <% }) %>

                                                                <% } else { %>
                                                                    <tr>
                                                                        <td colspan="6" class="text-center">
                                                                            No assigned officers found.
                                                                        </td>
                                                                    </tr>
                                                                <% } %>
                                                </tbody>
                                            </table>

                                        </div>
                                        <% } ) } %>
                                            <!-- Search & Filter -->
                                            <div class="card shadow-sm border-0 mb-4 mt-2">
                                                <div class="card-body">

                                                    <form action="/sos/day" method="GET">

                                                        <div class="row">

                                                            <div class="col-md-5">
                                                                <input type="date" name="date" class="form-control">
                                                            </div>

                                                            <div class="col-md-4">
                                                                <select name="status" class="form-select">

                                                                    <option value="">All Status</option>
                                                                    <option value="Active">Active</option>
                                                                    <option value="Resolved">Resolved</option>

                                                                </select>
                                                            </div>

                                                            <div class="col-md-3">
                                                                <button class="btn btn-success w-100">
                                                                    <i class="fa-solid fa-filter"></i> Filter
                                                                </button>
                                                            </div>

                                                        </div>
                                                    </form>
                                                </div>
                                            </div>



                                            <div class="card shadow border-0">

                                                <div class="card-body">

                                                    <div class="w-100">

                                                        <table class="table table-hover align-middle">

                                                            <thead class="table-danger">

                                                                <tr>
                                                                    <th>sl</th>
                                                                    <th>Image</th>
                                                                    <th>Name</th>
                                                                    <th>Phone</th>
                                                                    <th>Age</th>
                                                                    <th>Date</th>
                                                                    <th>Resolved Date</th>
                                                                    <th>Location</th>
                                                                    <th>Status</th>

                                                                </tr>
                                                            </thead>

                                                            <tbody>

                                                                <% if(sosList.length> 0){ %>
                                                                    <% sosList.forEach((sos,index)=>{ %>

                                                                        <tr>
                                                                            <td>
                                                                                <%= index+1 %>
                                                                            </td>

                                                                            <td><img src="<%= sos.user.image %>"
                                                                                    width="60" height="60">
                                                                            </td>

                                                                            <td>
                                                                                <%= sos.user.fullName %>
                                                                            </td>

                                                                            <td>
                                                                                <%= sos.user.phone %>
                                                                            </td>

                                                                            <% const birthDate=new Date(sos.user.dob);
                                                                                const today=new Date(); let
                                                                                age=today.getFullYear() -
                                                                                birthDate.getFullYear(); const
                                                                                monthDiff=today.getMonth() -
                                                                                birthDate.getMonth(); if (monthDiff < 0
                                                                                || (monthDiff===0 && today.getDate() <
                                                                                birthDate.getDate())) { age--; } %>

                                                                                <td>
                                                                                    <%= age %>
                                                                                </td>

                                                                                <td>
                                                                                    <%= new
                                                                                        Date(sos.createdAt).toLocaleDateString()
                                                                                        %>
                                                                                        <span class="pt-2">
                                                                                            <%= new
                                                                                                Date(sos.createdAt).toLocaleTimeString()
                                                                                                %>
                                                                                        </span>
                                                                                </td>

                                                                                <% if(sos.resolvedAt===null){ %>
                                                                                    <td>
                                                                                        <i
                                                                                            class="fa-solid fa-hourglass-half"></i>
                                                                                    </td>

                                                                                    <% } else { %>
                                                                                        <td>
                                                                                            <%= new
                                                                                                Date(sos.resolvedAt).toLocaleDateString()
                                                                                                %>
                                                                                                <span class="pt-2">
                                                                                                    <%= new
                                                                                                        Date(sos.resolvedAt).toLocaleTimeString()
                                                                                                        %>
                                                                                                </span>
                                                                                        </td>
                                                                                        <% } %>
                                                                                            <td>
                                                                                                <%= sos.address %>
                                                                                            </td>

                                                                                            <td>

                                                                                                <% if(sos.status=="Active"
                                                                                                    ){ %>
                                                                                                    <span
                                                                                                        class="badge bg-danger">
                                                                                                        Active
                                                                                                    </span>
                                                                                                    <% } else
                                                                                                        if(sos.status=="In Progress"
                                                                                                        ){ %>
                                                                                                        <span
                                                                                                            class="badge bg-warning text-dark">
                                                                                                            In Progress
                                                                                                        </span>

                                                                                                        <% } else
                                                                                                            if(sos.status=="Rejected"
                                                                                                            ){ %>
                                                                                                            <span
                                                                                                                class="badge bg-warning">
                                                                                                                Reject
                                                                                                            </span>

                                                                                                            <% } else {
                                                                                                                %>
                                                                                                                <span
                                                                                                                    class="badge bg-success">
                                                                                                                    Resolved
                                                                                                                </span>

                                                                                                                <% } %>

                                                                                            </td>

                                                                        </tr>

                                                                        <!-- Modal -->

                                                                        <% })} else { %>

                                                                            <tr>
                                                                                <td colspan="9"
                                                                                    class="text-center py-5">

                                                                                    <i
                                                                                        class="fa-solid fa-clock-rotate-left fa-3x text-secondary mb-3"></i>

                                                                                    <h5>No SOS History Found</h5>

                                                                                </td>

                                                                            </tr>

                                                                            <% } %>

                                                            </tbody>

                                                        </table>

                                                    </div>

                                                </div>

                                            </div>
                                </div>
                            </main>

                            <footer class="d-flex justify-content-between align-items-center px-4 py-3 mt-2 mb-2">
                                <div>
                                    Copyright © 2026 Admin
                                    <a href="#" class="fw-bold text-success text-decoration-none">
                                        Abhaya
                                    </a>
                                </div>

                                <div>
                                    Professional dashboard template.
                                </div>
                            </footer>

        </div>
    </div>

    <div class="modal fade" id="assignPoliceModal" tabindex="-1" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form action="/sos/assign-officers" method="POST">

                    <div class="modal-body">

                        <!-- SOS ID -->
                        <input type="hidden" name="sosId" id="assignSosId">


                        <p class="text-muted small">
                            Select one or more police officers
                            to handle this emergency case.
                        </p>


                        <% availableOfficers.forEach(officer=> { %>

                            <label class="police-option">

                                <input type="checkbox" name="policeIds" value="<%= officer._id %>">

                                <div class="police-icon">
                                    <i class="fa-solid fa-user-tie"></i>
                                </div>

                                <div class="police-info">

                                    <strong>
                                        <%= officer.fullName %>
                                    </strong>

                                    <small>
                                        <%= officer.designation || 'Police Officer' %>
                                    </small>

                                    <small>
                                        <%= officer.stationName %>
                                    </small>

                                    <small>
                                        <i class="fa-solid fa-phone"></i>
                                        <%= officer.phone || 'N/A' %>
                                    </small>

                                </div>

                            </label>

                            <% }) %>

                    </div>


                    <div class="modal-footer">

                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit" class="btn btn-primary">

                            <i class="fa-solid fa-user-plus me-1"></i>
                            Assign Officers

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <script>

        const socket = io();

        const bell = document.getElementById("bell");
        const count = document.getElementById("count");
        const notificationBox = document.getElementById("notificationBox");

        socket.on("sosSent", (sos) => {

            // const time = new Date(sos.createdAt).toLocaleString("en-IN");

            // Increase notification count
            count.textContent = Number(count.textContent) + 1;

            // Store the notification
            notificationBox.innerHTML += `
        <div class="alert alert-danger">
            <strong>SOS Alert</strong><br>
            ${sos.user} has sent an SOS alert. <br> Location: ${sos.location}. <br> Time: ${new Date(sos.createdAt).toLocaleString("en-IN")}.
        </div>`;
        });


        function openAssignModal(sosId) {

            document.getElementById("assignSosId").value = sosId;

            const modalElement =
                document.getElementById("assignPoliceModal");

            const modal =
                new bootstrap.Modal(modalElement);

            modal.show();
        }


    </script>

    <script src="../js/flash.js"></script>


    <script src="../assets/js/bootstrap.bundle.min.js"></script>
    <script src="../assets/js/main.js"></script>

</body>

</html>