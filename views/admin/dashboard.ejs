<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="adminHMD professional admin dashboard template">
  <title>Dashboard | Abhaya</title>

  <link rel="stylesheet" href="../assets/css/bootstrap.min.css">
  <link rel="stylesheet" href="../assets/vendors/bootstrap-icons/bootstrap-icons.css">
  <link rel="stylesheet" href="../assets/css/style.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css">

  <script src="/socket.io/socket.io.js"></script>

  <link rel="stylesheet" href="../css/flash.css">

</head>

<body>
  <div class="admin-shell">
    <div class="sidebar-backdrop" data-sidebar-close></div>

    <aside class="admin-sidebar" id="adminSidebar" aria-label="Main navigation">
      <div class="sidebar-header" style="display: flex; justify-content: center;">

        <div>
          <a class="brand-mark" href="/user/dashboard" aria-label="adminHMD dashboard">
            <img src="/img/core-img/abhaya-logo.png" alt="Abhaya Logo" style="height: 55px; width: 120px;">

          </a>
          <span class="brand-title">Admin Dashboard</span>
        </div>
      </div>

      <nav class="sidebar-nav">
        <a class="nav-link active" href="/admin/dashboard" aria-current="page">
          <span class="nav-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
          <span class="nav-text">Dashboard</span>
        </a>

        <a href="/user/profile" class="nav-link">
          <span class="nav-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
          <span class="nav-text">Profile</span>
        </a>

        <a href="/sos/all" class="nav-link">
          <span class="nav-icon"><i class="fas fa-history"></i></span>
          <span class="nav-text">SOS Alerts</span>
        </a>

        <a href="/user/all" class="nav-link">
          <span class="nav-icon"><i class="fa-solid fa-location-dot"></i></span>
          <span class="nav-text">Users</span>
        </a>

        <a href="/police/all" class="nav-link">
          <span class="nav-icon"><i class="fas fa-address-book"></i></span>
          <span class="nav-text">Police Contacts</span>
        </a>

        <a href="/report/all" class="nav-link">
          <span class="nav-icon"><i class="fas fa-exclamation-circle"></i></span>
          <span class="nav-text">Incident Report</span>
        </a>

        <a href="/user/safetytips" class="nav-link">
          <span class="nav-icon"><i class="fas fa-user-shield"></i></span>
          <span class="nav-text">Safety Tips</span>
        </a>

        </a>
        <a href="/user/settings" class="nav-link">
          <span class="nav-icon"><i class="bi bi-gear" aria-hidden="true"></i></span>
          <span class="nav-text">Settings</span>
        </a>

      </nav>

      <div class="sidebar-footer">
        <span class="status-dot"></span>
        <span class="sidebar-footer-text">System running smoothly</span>
      </div>
    </aside>

    <div class="admin-main">
      <nav class="navbar admin-navbar navbar-expand bg-white">
        <div class="container-fluid px-3 px-lg-4">
          <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="adminSidebar"
            aria-expanded="true" aria-label="Toggle sidebar">
            <span></span>
            <span></span>
            <span></span>
          </button>

          <form class="d-none d-md-flex ms-3 flex-grow-1" role="search">
            <input class="form-control search-input" type="search" placeholder="Search users, orders, reports"
              aria-label="Search">
          </form>

          <!-- <button id="sosBtn" class="btn btn-danger me-4">
            Emergency SOS
          </button> -->

          <div class="navbar-actions ms-auto">
            <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme"
              title="Switch color theme">
              <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>
            </button>
            <div class="dropdown">
              <div class="notification">
                <button class="icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                  aria-label="Notifications">

                  <i class="bi bi-bell" aria-hidden="true" id="bell"></i>
                  <span id="count" class="notificationbadge">0</span>
                </button>

                <div class="dropdown-menu dropdown-menu-end notification-menu" id="notificationBox">
                  <div class="dropdown-header fw-bold text-body">Notifications</div>

                </div>
              </div>
            </div>
            
            <div class="dropdown">
              <button class="profile-button dropdown-toggle" type="button" data-bs-toggle="dropdown"
                aria-expanded="false">
                <!-- <img class="avatar-img avatar-sm" src="../assets/images/avatar/avatar.jpg" alt="Admin Hasan"> -->
                <span class="d-none d-sm-inline">
                  <%= userData.name %>
                </span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/user/profile">Profile</a></li>
                <li><a class="dropdown-item" href="/user/settings">Account settings</a></li>
                <li>
                  <hr class="dropdown-divider">
                </li>
                <li><a class="dropdown-item" href="/auth/logout">Sign out</a></li>
              </ul>
            </div>
          </div>
        </div>
      </nav>

      <main class="dashboard-content">
        <div class="container-fluid px-3 px-lg-4 py-4">
          <div class="page-heading">
            <div class="page-heading-copy">
              <span class="page-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
              <div>
                <p class="eyebrow mb-1">Overview</p>
                <h1 class="h3 mb-1">Dashboard</h1>
                <p class="text-muted mb-0">Empowering women's safety through real-time monitoring, user
                  verification,
                  and emergency response management.</p>
              </div>
            </div>

            <% if (success && success.length> 0) { %>
        <div id="successAlert" class="custom-alert success-alert">
          <i class="fa-solid fa-circle-check"></i>
          <span>
            <%= success[0] %>
          </span>
          <button type="button" class="alert-close" onclick="this.parentElement.remove()">
            &times;
          </button>
        </div>
        <% } %>

          <% if (error && error.length> 0) { %>
            <div id="errorAlert" class="custom-alert error-alert">
              <i class="fa-solid fa-circle-exclamation"></i>
              <span>
                <%= error[0] %>
              </span>
              <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                &times;
              </button>
            </div>
            <% } %>

          </div>

          <section class="row g-3 mt-1" aria-label="Dashboard metrics">
            <div class="col-12 col-sm-6 col-xl-3">
              <article class="metric-card metric-danger">
                <div class="metric-top">
                  <span class="metric-label">SOS Sent</span>
                  <span class="metric-icon"><i class="fa-solid fa-shield-heart text-danger fs-2"></i></span>
                </div>
                <div class="metric-value">
                  <%= allSos.length %>
                </div>
                <div class="metric-meta">
                  <span class="text-danger">Total SOS Alerts</span>
                  <!-- <span>need review</span> -->
                </div>
              </article>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
              <article class="metric-card metric-primary">
                <div class="metric-top">
                  <span class="metric-label">Polices</span>
                  <span class="metric-icon"><i class="fa-solid fa-location-dot text-primary fs-2"></i></span>
                </div>
                <div class="metric-value">
                  <%= allPolices.length %>
                </div>
                <div class="metric-meta">
                  <span class="text-primary">All Polices</span>
                  <!-- <span>Live Location</span> -->
                </div>
              </article>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
              <article class="metric-card metric-success">
                <div class="metric-top">
                  <span class="metric-label">Users</span>
                  <span class="metric-icon"><i class="fa-solid fa-user-group text-success fs-2"></i></span>
                </div>
                <div class="metric-value">
                  <%= allUsers.length %>
                </div>
                <div class="metric-meta">
                  <!-- <span class="text-success">3</span> -->
                  <span class="text-success">All Users</span>
                </div>
              </article>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
              <article class="metric-card metric-warning">
                <div class="metric-top">
                  <span class="metric-label">Reports</span>
                  <span class="metric-icon"><i class="fa-solid fa-file-circle-exclamation text-warning fs-2"></i></span>
                </div>
                <div class="metric-value">
                  <%= allReports.length %>
                </div>
                <div class="metric-meta">
                  <span class="text-warning">Submitted Reports</span>
                  <!-- <span>active users</span> -->
                </div>
              </article>
            </div>
          </section>

          <section class="row g-3 mt-1">
            <div class="col-12 col-xl-8">
              <div class="panel">
                <div class="panel-header">
                  <div>
                    <h2 class="h5 mb-1 section-title"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span>User
                        Registrations</span></h2>
                    <p class="text-muted mb-0">Monthly growth of registered users on the Abhaya platform.</p>
                  </div>
                  <a class="btn btn-light btn-sm" href="#">View Reports</a>
                </div>

                <div class="chart-bars" aria-label="Sales performance chart">
                  <div class="chart-column bar-42"><span></span><small>Jan</small></div>
                  <div class="chart-column bar-58"><span></span><small>Feb</small></div>
                  <div class="chart-column bar-51"><span></span><small>Mar</small></div>
                  <div class="chart-column bar-72"><span></span><small>Apr</small></div>
                  <div class="chart-column bar-66"><span></span><small>May</small></div>
                  <div class="chart-column bar-83"><span></span><small>Jun</small></div>
                </div>
              </div>
            </div>

            <div class="col-12 col-xl-4">
              <div class="panel h-100">
                <div class="panel-header">
                  <div>
                    <h6 class="h5 mb-1 section-title"><i class="bi bi-activity" aria-hidden="true"></i><span>Emergency
                        Contact Numbers</span></h6>
                    <p class="text-muted mb-0">Important Emergency Numbers</p>
                  </div>
                </div>
                <div class="row ms-3 mb-5">

                  <div class="number-card">

                    <i class="fa-solid fa-shield text-primary me-3"></i>

                    <span class="mt-3 me-5 h5">Police</span>

                    <span class="mt-3 ms-3 me-3 h5">100</span>

                    <a href="tel:100" class="btn btn-outline-primary mt-2 mb-3">
                      Call Now
                    </a>

                  </div>

                  <div class="number-card">

                    <i class="fa-solid fa-truck-medical text-danger"></i>

                    <span class="mt-3 ms-3 me-3 h5">Ambulance</span>

                    <span class="mt-3 me-3 h5">108</span>

                    <a href="tel:108" class="btn btn-outline-danger mt-2 mb-3">
                      Call Now
                    </a>

                  </div>

                  <div class="number-card">

                    <i class="fa-solid fa-fire text-warning"></i>

                    <span class="mt-3 ms-4 me-4 h5">Fire Service</span>

                    <span class="mt-3 me-3 h5">101</span>

                    <a href="tel:101" class="btn btn-outline-warning mt-2 mb-3">
                      Call Now
                    </a>

                  </div>

                </div>

              </div>
            </div>

          </section>

          <section class="row g-3 mt-3" aria-label="Dashboard metrics">
            <div class="row">
              <div class="col-lg-6">
                <div class="card p-4 shadow-sm">
                  <h3>Users by Role</h3>
                  <canvas id="usersChart" height="200"></canvas>
                </div>
              </div>

              <div class="col-lg-6">
                <div class="card p-4 shadow-sm">
                  <h3>Incident Reports by Type</h3>
                  <canvas id="incidentChart" height="200"></canvas>
                </div>
              </div>
            </div>

          </section>

          <section class="panel mt-3">
            <div class="panel-header">
              <div>
                <h2 class="h5 mb-1 section-title"><i class="bi bi-people" aria-hidden="true"></i><span>Recent
                    Users</span></h2>
                <p class="text-muted mb-0">Latest account activity across the workspace.</p>
              </div>
              <a class="btn btn-outline-secondary btn-sm" href="#">Manage Users</a>
            </div>
            <div class="table">
              <table class="table align-middle mb-0">
                <thead>
                  <tr>
                    <th scope="col">Image</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Phone</th>
                    <th scope="col">DOB</th>
                    <th scope="col">City</th>
                    <th scope="col">District</th>
                    <th scope="col">Status</th>

                    <th scope="col">Verify</th>
                  </tr>
                </thead>
                <tbody>

                  <% if(allUsers.length===0){ %>
                    <tr>
                      <td colspan="9" class="text-center">
                        ----- No Data Found -----
                      </td>
                    </tr>
                    <% } allUsers.forEach((user)=> { %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center gap-2">
                            <img class="avatar-img avatar-sm" src="<%= user.image %>" alt="user-image">

                          </div>
                        </td>
                        <td>

                          <%= user.fullName %>

                        </td>
                        <td>
                          <%= user.email %>
                        </td>
                        <td>
                          <%= user.phone %>
                        </td>
                        <% const date=new Date(user.dob); const formattedDate=String(date.getUTCDate()).padStart(2, "0"
                          ) + "-" + String(date.getUTCMonth() + 1).padStart(2, "0" ) + "-" + date.getUTCFullYear(); %>

                          <td>
                            <%= formattedDate %>
                          </td>

                          <td>
                            <%= user.city %>
                          </td>

                          <td>
                            <%= user.district %>

                          <td>
                            <form action="/user/status/<%= user._id %>" method="POST">
                              <label class="switch">
                                <input type="checkbox" name="status" value="Active" <%=user.status==="Active"
                                  ? "checked" : "" %>
                                onchange="this.form.submit()">

                                <span class="slider"></span>
                              </label>
                            </form>
                          </td>

                          <td>
                            <form action="/user/verify/<%= user._id %>" method="POST">

                              <% if (user.isVerified) { %>

                                <!-- Verified -->
                                <button type="submit" class="btn btn-sm btn-success" title="Unverify User">
                                  <i class="fa-solid fa-circle-check"></i>
                                </button>

                                <% } else { %>

                                  <!-- Not Verified -->
                                  <button type="submit" class="btn btn-sm btn-warning" title="Verify User">
                                    <i class="fa-solid fa-user-plus"></i>
                                  </button>

                                  <% } %>
                            </form>
                          </td>
                      </tr>
                      <% }) %>

                </tbody>
              </table>
            </div>
          </section>

          <section class="panel mt-3">
            <div class="panel-header">
              <div>
                <h2 class="h5 mb-1 section-title"><i class="bi bi-people" aria-hidden="true"></i><span>Polices</span>
                </h2>
                <p class="text-muted mb-0">Latest account activity across the workspace.</p>
              </div>
              <a class="btn btn-outline-secondary btn-sm" href="#">Manage Polices</a>
            </div>
            <div class="table">
              <table class="table align-middle mb-0">
                <thead>
                  <tr>
                    <th scope="col">Image</th>
                    <th scope="col">Police Station</th>
                    <th scope="col">Officer Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Phone</th>
                    <!-- <th scope="col">City</th> -->
                    <th scope="col">District</th>
                    <th scope="col">Status</th>

                    <th scope="col">Verify</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(allPolices.length===0){ %>
                    <tr>
                      <td colspan="9" class="text-center">
                        ----- No Data Found -----
                      </td>
                    </tr>
                    <% } allPolices.forEach((user)=> { %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center gap-2">
                            <img class="avatar-img avatar-sm" src="<%= user.image %>" alt="user-image">

                          </div>
                        </td>
                        <td>
                          <%= user.stationName %>
                        </td>
                        <td>
                          <%= user.fullName %>
                        </td>

                        <td>
                          <%= user.email %>
                        </td>
                        <td>
                          <%= user.phone %>
                        </td>
                        
                        <td>
                          <%= user.district %>
                        </td>

                        <td>
                          <form action="/user/status/<%= user._id %>" method="POST">
                            <label class="switch">
                              <input type="checkbox" name="status" value="Active" <%=user.status==="Active" ? "checked"
                                : "" %>
                              onchange="this.form.submit()">

                              <span class="slider"></span>
                            </label>
                          </form>
                        </td>

                        <td>
                          <form action="/user/verify/<%= user._id %>" method="POST">

                            <% if (user.isVerified) { %>

                              <!-- Verified -->
                              <button type="submit" class="btn btn-sm btn-success" title="Unverify User">
                                <i class="fa-solid fa-circle-check"></i>
                              </button>

                              <% } else { %>

                                <!-- Not Verified -->
                                <button type="submit" class="btn btn-sm btn-warning" title="Verify User">
                                  <i class="fa-solid fa-user-plus"></i>
                                </button>

                                <% } %>
                          </form>
                        </td>
                      </tr>
                      <% }) %>

                </tbody>
              </table>
            </div>
          </section>
        </div>
      </main>

      <footer class="d-flex justify-content-between align-items-center px-4 py-3 mt-2 mb-2">
        <div>
          Copyright © 2026 Admin
          <a href="#" class="fw-bold text-success text-decoration-none">
            Abhaya
          </a>
        </div>

        <div>
          Professional dashboard template.
        </div>
      </footer>
    </div>
  </div>

  <script>
    const socket = io();

    const bell = document.getElementById("bell");
    const count = document.getElementById("count");
    const notificationBox = document.getElementById("notificationBox");


    socket.on("sosSent", (sos) => {

      // const time = new Date(sos.createdAt).toLocaleString("en-IN");

      // Increase notification count
      count.textContent = Number(count.textContent) + 1;

      // Store the notification
      notificationBox.innerHTML += `
        <div class="alert alert-danger">
            <strong>SOS Alert</strong><br>
            ${sos.user} has sent an SOS alert. <br> Location: ${sos.location}. <br> Time: ${new Date(sos.createdAt).toLocaleString("en-IN")}.
        </div>`;
    });

    // Show notifications when the bell is clicked
    // bell.addEventListener("click", () => {

    //   if (notificationBox.style.display === "none") {
    //     notificationBox.style.display = "block";
    //     count.textContent = 0;
    //   } else {
    //     notificationBox.style.display = "none";
    //   }

    // });

  </script>

  <script src="../js/flash.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="../assets/js/chart.js"></script>

  <script src="../assets/js/bootstrap.bundle.min.js"></script>
  <script src="../assets/js/main.js"></script>
</body>

</html>