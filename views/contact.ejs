<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="VaultEdge - Premium financial planning and investment management HTML template">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>Abhaya - Woman Safety Platform</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/custom-override.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
        integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="../css/flash.css">

</head>

<body>
    <!-- Preloader -->
    
    <!-- ===== NAVBAR (single dark bar, logo left, nav center, CTA right) ===== -->
    <header class="ve-header" id="ve-sticky">
        <div class="container-fluid ve-nav-wrap">
            <!-- Logo -->
            <div>
                <a href="/auth/woman-safety">
                    <a href="/" class="logo">
                        <img src="/img/core-img/abhaya-logo.png" alt="Abhaya Logo">
                    </a>
                </a>
            </div>

            <!-- Nav Links -->
            <nav class="ve-nav">
                <ul>
                    <ul>
                        <li><a href="/abhaya/">Home</a></li>
                        <li><a href="/abhaya/about">About Us</a></li>
                        <li><a href="/abhaya/features">Features</a></li>
                        <li><a href="/abhaya/safety-tips">Safety Tips</a></li>
                        <li><a href="/contact/support">Contact Us</a></li>
                        
                    </ul>
                </ul>
            </nav>

            <!-- CTA -->
            <div class="ve-nav-cta" style="display: flex; gap: 12px;">

                <a href="/auth/login" class="ve-cta-btn">Login</a>

                <a href="/sos/send" class="ve-cta-btn">Emergency SOS <i class="fa fa-arrow-right"></i></a>
            </div>

            <!-- Mobile Toggle -->
            <button class="ve-toggler" id="ve-toggle">
                <span></span><span></span><span></span>
            </button>
        </div>

    </header>

    <% if (success && success.length> 0) { %>
            <div id="successAlert" class="custom-alert success-alert">
              <i class="fa-solid fa-circle-check"></i>
              <span>
                <%= success[0] %>
              </span>
              <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                &times;
              </button>
            </div>
            <% } %>

              <% if (error && error.length> 0) { %>
                <div id="errorAlert" class="custom-alert error-alert">
                  <i class="fa-solid fa-circle-exclamation"></i>
                  <span>
                    <%= error[0] %>
                  </span>
                  <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                    &times;
                  </button>
                </div>
                <% } %>

    <section class="ve-page-hero" style="background-image:url(/img/bg-img/22.jpg);">
        <div class="ve-page-hero-overlay"></div>
        <div class="container ve-page-hero-content">
            <span class="ve-section-tag bg-warning text-dark">Get In Touch</span>
            <h1>We'd Love to <span>Hear From You</span></h1>
            <nav aria-label="breadcrumb"><ol class="ve-breadcrumb"><li><a href="/abhaya/">Home</a></li><li class="active">Contact</li></ol></nav>
        </div>
    </section>

    <section class="ve-contact-cards-section">
        <div class="container">
            <div class="ve-contact-cards-grid">
                <div class="ve-contact-info-card wow fadeInUp" data-wow-delay="100ms"><div class="ve-ci-icon"><i class="fa-solid fa-location-dot"></i></div><h5>Visit Our Office</h5><p>Kolkata, India</p></div>
                <div class="ve-contact-info-card wow fadeInUp" data-wow-delay="250ms"><div class="ve-ci-icon"><i class="fa fa-phone"></i></div><h5>Call Us</h5><p>+91 80000 00000<br><small>Mon–Fri, 9am – 6pm PST</small></p></div>
                <div class="ve-contact-info-card wow fadeInUp" data-wow-delay="400ms"><div class="ve-ci-icon"><i class="fa fa-envelope"></i></div><h5>Email Us</h5><p>support@abhaya.com<br><small>We reply within 24 hours</small></p></div>
            </div>
        </div>
    </section>

    <section class="support-section py-5">
    <div class="container">
        <div class="row g-4">

            <!-- Left: Support Form -->
            <div class="col-lg-8">
                <div class="support-card">

                    <span class="ve-section-tag">
                        
                        <i class="fa-solid fa-shield-heart"></i>
                        SAFETY SUPPORT
                    </span>

                    <h2 class="support-title">
                        
                        We're Here to
                        <span>Help You</span>
                    </h2>

                    <p class="support-text">
                        Have a question, need assistance, or want to report
                        an incident? Fill out the form and our support team
                        will get back to you as soon as possible.
                    </p>

                    <form action="/contact/support-create" method="POST">

                        <div class="row g-4">

                            <!-- Name -->
                            <div class="col-md-6">
                                <label>FULL NAME</label>
                                <input type="text"
                                       name="name"
                                       class="form-control"
                                       placeholder="Your full name"
                                       required>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label>EMAIL ADDRESS</label>
                                <input type="email"
                                       name="email"
                                       class="form-control"
                                       placeholder="Your email"
                                       required>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6 mt-2">
                                <label>PHONE NUMBER</label>
                                <input type="tel"
                                       name="phone"
                                       class="form-control"
                                       placeholder="Your phone number">
                            </div>

                            <!-- Type -->
                            <div class="col-md-6 mt-2">
                                <label>TYPE OF REQUEST</label>

                                <select name="type"
                                        class="form-control"
                                        required>

                                    <option value="">
                                        Select an option
                                    </option>

                                    <option value="Safety Support">
                                        Safety Support
                                    </option>

                                    <option value="Report Incident">
                                        Report an Incident
                                    </option>

                                    <option value="Technical Help">
                                        Technical Help
                                    </option>

                                    <option value="General Query">
                                        General Query
                                    </option>

                                </select>
                            </div>

                            <!-- Message -->
                            <div class="col-12 mt-2">
                                <label>YOUR MESSAGE</label>

                                <textarea name="message"
                                          class="form-control"
                                          rows="6"
                                          placeholder="Tell us how we can help you..."
                                          required></textarea>
                            </div>

                            <!-- Button -->
                            <div class="col-12 mt-4">

                                <button type="submit"
                                        class="btn support-btn w-100">
                                    Send Message &nbsp;<i class="fa fa-paper-plane"></i>

                                </button>

                            </div>

                        </div>

                    </form>

                </div>
            </div>


            <!-- Right Side -->
            <div class="col-lg-4">

                <!-- Why Contact Us -->
                <div class="help-card">

                    <h5>
                        <i class="fa-solid fa-shield-heart"></i>
                        How We Can Help
                    </h5>

                    <ul>

                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            Safety and emergency support
                        </li>

                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            Report harassment or incidents
                        </li>

                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            Assistance with SOS requests
                        </li>

                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            Technical support
                        </li>

                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            General queries and guidance
                        </li>

                    </ul>

                </div>


                <!-- Emergency -->
                <div class="emergency-card">

                    <h5>
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Emergency?
                    </h5>

                    <p>
                        If you are in immediate danger, don't wait for a
                        response. Use the Emergency SOS button to alert
                        your emergency contacts.
                    </p>

                    <a href="/sos" class="emergency-btn">
                        <i class="fa-solid fa-bell"></i>
                        Send Emergency SOS
                    </a>

                </div>


                <!-- Contact -->
                <div class="connect-card">

                    <h5>Connect With Abhaya</h5>

                    <div class="contact-item">
                        <i class="fa-solid fa-phone"></i>
                        <div>
                            <strong>Call Us</strong>
                            <p>+91 80000 00000</p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <i class="fa-solid fa-envelope"></i>
                        <div>
                            <strong>Email Us</strong>
                            <p>support@abhaya.com</p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <i class="fa-solid fa-location-dot"></i>
                        <div>
                            <strong>Location</strong>
                            <p>Kolkata, India</p>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</section>
    
    <footer class="ve-footer">
        <div class="container">
            <div class="row">

                <!-- Col 1: Brand -->
                <div class="col-12 col-sm-6 col-lg-4 mb-50">
                    <div class="ve-footer-brand">


                        <a href="/" class="logo">
                            <img src="/img/core-img/abhaya-logo.png" alt="Abhaya Logo">

                        </a>

                        <p>
                            Empowering women with smart safety solutions,
                            emergency protection, and technology-driven security.
                        </p>

                        <div class="ve-social">
                            <a href="#"><i class="fa-brands fa-facebook"></i></a>
                            <a href="#"><i class="fa-brands fa-twitter"></i></a>
                            <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                            <a href="#"><i class="fa-brands fa-instagram"></i></a>
                        </div>

                    </div>
                </div>


                <!-- Col 2: Quick Links -->
                <div class="col-12 col-sm-6 col-lg-2 mb-50">

                    <h5 class="ve-footer-title">Quick Links</h5>

                    <ul class="ve-footer-links">
                        <li><a href="/abhaya/">Home</a></li>
                        <li><a href="/abhaya/about">About Us</a></li>
                        <li><a href="/abhaya/features">Features</a></li>
                        <li><a href="/abhaya/safety-tips">Safety Tips</a></li>
                        <li><a href="/contact/support">Contact</a></li>
                    </ul>

                </div>


                <!-- Col 3: Services -->
                <div class="col-12 col-sm-6 col-lg-3 mb-50">

                    <h5 class="ve-footer-title">Safety Features</h5>

                    <ul class="ve-footer-links">
                        <li><a href="#">Emergency SOS</a></li>
                        <li><a href="#">Live Location Tracking</a></li>
                        <li><a href="#">Trusted Contacts</a></li>
                        <li><a href="#">Safety Alerts</a></li>
                        <li><a href="#">24/7 Support</a></li>
                    </ul>

                </div>


                <!-- Col 4: Contact -->
                <div class="col-12 col-sm-6 col-lg-3 mb-50">

                    <h5 class="ve-footer-title">Get In Touch</h5>

                    <ul class="ve-footer-contact">
                        <li>
                            <i class="fa-solid fa-location-dot"></i>
                            Kolkata, India
                        </li>

                        <li>
                            <i class="fa fa-phone"></i>
                            +91 80000 00000
                        </li>

                        <li>
                            <i class="fa fa-envelope"></i>
                            support@abhaya.com
                        </li>

                        <li>
                            <i class="fa fa-clock-o"></i>
                            Available 24/7
                        </li>
                    </ul>

                </div>

            </div>
        </div>


        <!-- Footer Bottom Bar -->
        <div class="ve-footer-bottom">

            <div class="container">

                <div class="ve-footer-bottom-inner">

                    <p>
                        Copyright &copy;
                        <script>
                            document.write(new Date().getFullYear());
                        </script>
                        Abhaya. All Rights Reserved
                    </p>

                    <ul>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms of Use</a></li>
                        <li><a href="#">Safety Guidelines</a></li>
                    </ul>

                </div>

            </div>

        </div>

    </footer>

    <script src="../js/flash.js"></script>

    <!-- Scripts -->
    <script src="js/jquery/jquery-2.2.4.min.js"></script>
    <script src="js/bootstrap/popper.min.js"></script>
    <script src="js/bootstrap/bootstrap.min.js"></script>
    <script src="js/plugins/plugins.js"></script>
    <script src="js/active.js"></script>
    <script src="js/vaultedge.js"></script>
</body>
</html>