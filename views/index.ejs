                        <div class="ve-whyus-badge">
                            <strong>24/7</strong>
                            <span>Safety Protection</span>
                        </div>
                    </div>
                </div>

                <!-- Content Side -->
                <div class="col-12 col-lg-7 wow fadeInRight" data-wow-delay="200ms">
                    <div class="ve-whyus-content">

                        <span class="ve-section-tag">Why SafeHer</span>

                        <h2>A Smarter Way to Stay <span>Safe</span></h2>

                        <p>
                            We combine smart technology with instant emergency response features
                            to provide reliable protection and support whenever you need it.
                        </p>

                        <div class="ve-checklist">

                            <div class="ve-check-item">
                                <i class="fa fa-check-circle"></i>
                                <div>
                                    <strong>Instant SOS Alerts</strong>
                                    <p>
                                        Send emergency alerts quickly to your trusted contacts during dangerous
                                        situations.
                                    </p>
                                </div>
                            </div>

                            <div class="ve-check-item">
                                <i class="fa fa-check-circle"></i>
                                <div>
                                    <strong>Real-Time Tracking</strong>
                                    <p>
                                        Share your live location with family members for better safety and awareness.
                                    </p>
                                </div>
                            </div>

                            <div class="ve-check-item">
                                <i class="fa fa-check-circle"></i>
                                <div>
                                    <strong>24/7 Safety Support</strong>
                                    <p>
                                        Get continuous assistance and emergency guidance whenever you need help.
                                    </p>
                                </div>
                            </div>

                        </div>

                        <a href="about.html" class="ve-btn-primary mt-30">
                            Discover Our Mission
                        </a>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ===== COUNTERS ===== -->
    <section class="ve-counter-section">
        <div class="container">
            <div class="ve-counter-grid">
                <div class="ve-counter-item wow fadeInUp" data-wow-delay="100ms">
                    <i class="fa fa-users"></i>
                    <strong class="counter" data-count="50000">0</strong><span>+</span>
                    <p>Happy Clients</p>
                </div>
                <div class="ve-counter-item wow fadeInUp" data-wow-delay="200ms">
                    <i class="fa fa-briefcase"></i>
                    <strong class="counter" data-count="4200">0</strong><span>M+</span>
                    <p>Emergency Assistance</p>
                </div>
                <div class="ve-counter-item wow fadeInUp" data-wow-delay="300ms">
                    <i class="fa fa-globe"></i>
                    <strong class="counter" data-count="30">0</strong><span>+</span>
                    <p>Countries Served</p>
                </div>
                <div class="ve-counter-item wow fadeInUp" data-wow-delay="400ms">
                    <i class="fa fa-trophy"></i>
                    <strong class="counter" data-count="18">0</strong><span></span>
                    <p>Industry Awards</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== TESTIMONIALS ===== -->
    <section class="ve-section ve-testimonials-section">
        <div class="container">
            <div class="ve-section-header text-center">
                <span class="ve-section-tag">User Stories</span>
                <h2>What Our <span>Users Say</span></h2>
            </div>

            <div class="ve-testi-grid">

                <!-- Testimonial 1 -->
                <div class="ve-testi-card wow fadeInUp" data-wow-delay="100ms">
                    <div class="ve-testi-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                    <p>"Abhaya gave me confidence while traveling alone. The instant SOS feature and live location
                        sharing helped me feel secure throughout my journey."</p>

                    <div class="ve-testi-author">
                        <div class="ve-testi-avatar bg-img" style="background-image:url(/img/bg-img/28.jpg);">
                        </div>
                        <div>
                            <strong>Priya Sharma</strong>
                            <span>College Student</span>
                        </div>
                    </div>
                </div>

                <!-- Testimonial 2 -->
                <div class="ve-testi-card wow fadeInUp" data-wow-delay="250ms">
                    <div class="ve-testi-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                    <p>"The real-time location sharing feature keeps my family informed whenever I travel late at night.
                        It's simple, reliable, and reassuring."</p>

                    <div class="ve-testi-author">
                        <div class="ve-testi-avatar bg-img" style="background-image:url(/img/bg-img/27.jpg);">
                        </div>
                        <div>
                            <strong>Ananya Roy</strong>
                            <span>Software Engineer</span>
                        </div>
                    </div>
                </div>

                <!-- Testimonial 3 -->
                <div class="ve-testi-card wow fadeInUp" data-wow-delay="400ms">
                    <div class="ve-testi-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                    <p>"Abhaya is easy to use and provides peace of mind. Knowing that my emergency contacts can be
                        alerted instantly makes me feel much safer."</p>

                    <div class="ve-testi-author">
                        <div class="ve-testi-avatar bg-img" style="background-image:url(/img/bg-img/30.jpg);">
                        </div>
                        <div>
                            <strong>Neha Das</strong>
                            <span>Working Professional</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ===== CTA BANNER ===== -->
    <section class="ve-cta-banner bg-img" style="background-image:url(/img/bg-img/6.jpg);">
        <div class="ve-cta-overlay"></div>

        <div class="container ve-cta-content">
            <div class="row align-items-center">

                <div class="col-12 col-lg-8">
                    <h2>
                        Stay Safe, Stay <span>Protected Anytime</span>
                    </h2>
                    <p>
                        Join SafeHer today and get instant access to emergency alerts,
                        safety tracking, and 24/7 support whenever you need it.
                    </p>
                </div>

                <div class="col-12 col-lg-4 text-lg-right">
                    <a href="/auth/register" class="ve-btn-white">
                        Get Started Now
                    </a>
                </div>

            </div>
        </div>
    </section>

    <!-- ===== LATEST REPORTS ===== -->

    <section class="ve-section ve-insights-section">
        <div class="container">

            <div class="ve-section-header text-center">
                <span class="ve-section-tag">Reports</span>
                <h2>Latest <span>Reports</span></h2>
                <p>
                    Stay informed with latest Reports, stay informed
                    and follow guidelines.
                </p>
            </div>

            <div class="row">
                <% allReports.forEach((report)=> { %>

                    <div class="col-12 col-md-4 wow fadeInUp" data-wow-delay="100ms">

                        <div class="ve-insight-card">

                            <div class="ve-insight-img bg-img" style="background-image:url('<%= report.evidence %>');">
                            </div>

                            <div class="ve-insight-body">

                                <h5>
                                    <a href="#">
                                        <%= report.incidentType.incidenttypeName %>
                                    </a>
                                </h5>

                                <p>
                                    <%= report.description %>
                                </p>

                                <p>
                                    <%= report.location %>
                                </p>

                                <div class="ve-insight-meta">
                                    <span>
                                        <i class="fa fa-calendar"></i>
                                        <%= new Date(report.createdAt).toLocaleDateString() %>
                                    </span>

                                    <a href="#">
                                        Read More <i class="fa fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>

                        </div>

                    </div>
                    <% }); %>

            </div>
        </div>
    </section>

    <!-- ===== NEWSLETTER ===== -->

    <section class="emergency-section py-5">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-lg-7">
                    <span class="badge bg-warning text-dark mb-3 p-3" style="font-size: 1rem; border-radius: 5px;">
                        <i class="fa-solid fa-shield-heart"></i> Emergency Support
                    </span>

                    <h2 class="text-white fw-bold">
                        Need Immediate Help?
                    </h2>

                    <p class="text-light mt-3">
                        If you are in danger, use the SOS button to instantly notify
                        your trusted contacts and nearby authorities with your live
                        location.
                    </p>

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="/auth/login" class="btn btn-warning px-4" style="border-radius: 25px;">
                            <!-- <i class="fa-solid fa-triangle-exclamation"></i> -->
                            Send SOS
                        </a>

                        <a href="/auth/register" class="btn btn-outline-light px-4" style="margin-left: 10px; border-radius: 25px;">
                            Create Account
                        </a>
                    </div>
                </div>

                <div class="col-lg-5 mt-4 mt-lg-0">
                    <div class="helpline-card">

                        <h4 class="text-secondary mb-3">
                            Emergency Helpline
                        </h4>

                        <div class="helpline-item">
                            <span>🚓 Police</span>
                            <strong>112</strong>
                        </div>

                        <div class="helpline-item">
                            <span>👩 Women Helpline</span>
                            <strong>181</strong>
                        </div>

                        <div class="helpline-item">
                            <span>🚑 Ambulance</span>
                            <strong>108</strong>
                        </div>

                        <div class="helpline-item">
                            <span>👶 Child Helpline</span>
                            <strong>1098</strong>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ===== LATEST INSIGHTS ===== -->
    <section class="ve-section ve-insights-section">
        <div class="container">

            <div class="ve-section-header text-center">
                <span class="ve-section-tag">Safety Tips &amp; Awareness</span>
                <h2>Latest Safety <span>Insights</span></h2>
                <p>
                    Stay informed with expert safety advice, emergency preparedness tips,
                    and awareness guides.
                </p>
            </div>

            <div class="row">

                <div class="col-12 col-md-4 wow fadeInUp" data-wow-delay="100ms">
                    <div class="ve-insight-card">
                        <div class="ve-insight-img bg-img" style="background-image:url(/img/bg-img/10.jpg);">
                        </div>

                        <div class="ve-insight-body">
                            <span class="ve-insight-cat">Personal Safety</span>

                            <h5>
                                <a href="single-post.html">
                                    5 Essential Safety Tips for Everyday Life
                                </a>
                            </h5>

                            <p>
                                Learn simple safety practices that help you stay alert
                                and prepared in any situation.
                            </p>

                            <div class="ve-insight-meta">
                                <span>
                                    <i class="fa fa-calendar"></i> April 26
                                </span>

                                <a href="single-post.html">
                                    Read More <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4 wow fadeInUp" data-wow-delay="400ms">
                    <div class="ve-insight-card">

                        <div class="ve-insight-img bg-img" style="background-image:url(/img/bg-img/12.jpg);">
                        </div>

                        <div class="ve-insight-body">

                            <span class="ve-insight-cat">Technology</span>

                            <h5>
                                <a href="single-post.html">
                                    How Smart Technology Improves Women's Safety
                                </a>
                            </h5>

                            <p>
                                Explore how AI, tracking, and wearable technology
                                are creating safer environments.
                            </p>

                            <div class="ve-insight-meta">
                                <span>
                                    <i class="fa fa-calendar"></i> April 14
                                </span>

                                <a href="single-post.html">
                                    Read More <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4 wow fadeInUp" data-wow-delay="250ms">
                    <div class="ve-insight-card">

                        <div class="ve-insight-img bg-img" style="background-image:url(/img/bg-img/11.jpg);">
                        </div>

                        <div class="ve-insight-body">

                            <span class="ve-insight-cat">Emergency Guide</span>

                            <h5>
                                <a href="single-post.html">
                                    How to Use SOS Features During Emergencies
                                </a>
                            </h5>

                            <p>
                                Understand how instant alerts and emergency contacts
                                can help during critical situations.
                            </p>

                            <div class="ve-insight-meta">
                                <span>
                                    <i class="fa fa-calendar"></i> April 20
                                </span>

                                <a href="single-post.html">
                                    Read More <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- ===== FOOTER (dark, 4-column) ===== -->
