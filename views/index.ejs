<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="VaultEdge - Premium financial planning and investment management HTML template">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>Abhaya - Woman Safety Platform</title>

    <!-- <link rel="icon" href="/img/core-img/favicon.ico"> -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/custom-override.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
        integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="../css/flash.css">

</head>

<body>
    <!-- Preloader -->
    <div class="preloader d-flex align-items-center justify-content-center">
        <div class="lds-ellipsis">
            <div></div>
            <div></div>
            <div></div>
            <div></div>
        </div>
    </div>

    
    <!-- ===== NAVBAR (single dark bar, logo left, nav center, CTA right) ===== -->
    <header class="ve-header" id="ve-sticky">
        <div class="container-fluid ve-nav-wrap">
            <!-- Logo -->
            <div>
                <a href="/auth/woman-safety">
                    <a href="/auth/woman-safety" class="logo">
                        <img src="/img/core-img/abhaya-logo.png" alt="Abhaya Logo">
                    </a>
                    
                </a>
            </div>

            <!-- Nav Links -->
            <nav class="ve-nav">
                <ul>
                    <ul>
                        <li><a href="/abhaya/">Home</a></li>
                        <li><a href="/abhaya/about">About Us</a></li>
                        <li><a href="/abhaya/features">Features</a></li>
                        <!-- <li><a href="sos.html">Emergency SOS</a></li> -->
                        <li><a href="/abhaya/safety-tips">Safety Tips</a></li>
                        <li><a href="/contact/support">Contact Us</a></li>

                    </ul>
                </ul>
            </nav>

            <!-- CTA -->
            <div class="ve-nav-cta" style="display: flex; gap: 12px;">

                <a href="/auth/login" class="ve-cta-btn">Login</a>
                <a href="/auth/login" class="ve-cta-btn">Emergency SOS <i class="fa fa-arrow-right"></i></a>
            </div>

            <!-- Mobile Toggle -->
            <button class="ve-toggler" id="ve-toggle">
                <span></span><span></span><span></span>
            </button>
        </div>

    </header>

    <!-- ===== HERO: Split layout — left text, right image panel ===== -->
    <section class="ve-hero">

        <% if (success && success.length> 0) { %>
            <div id="successAlert" class="custom-alert success-alert">
              <i class="fa-solid fa-circle-check"></i>
              <span>
                <%= success[0] %>
              </span>
              <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                &times;
              </button>
            </div>
            <% } %>

              <% if (error && error.length> 0) { %>
                <div id="errorAlert" class="custom-alert error-alert">
                  <i class="fa-solid fa-circle-exclamation"></i>
                  <span>
                    <%= error[0] %>
                  </span>
                  <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                    &times;
                  </button>
                </div>
                <% } %>

        <!-- Left Panel -->
        <div class="ve-hero-left">
            <span class="ve-hero-badge">Abhaya Safety • Network Protecting Every Journey &nbsp;•&nbsp; GPS • SOS •
                Empower • Protect • Respond</span>
            <h1>Your <span class="ve-highlight">Safety</span><br>Our Commitment</h1>

            <p>
                Stay protected with Abhaya's advanced safety features including one-tap SOS,
                live GPS tracking, trusted emergency contacts, and instant notifications
                during critical situations.
            </p>
            <div class="ve-hero-btns">
                <a href="/auth/register" class="ve-btn-primary">
                    <i class="fa fa-user-plus"></i> Get Started
                </a>

                <a href="/abhaya/about" class="ve-btn-ghost">
                    <i class="fa fa-info-circle"></i> Learn More
                </a>
            </div>
            <!-- Quick Stats Row -->
            <div class="ve-hero-stats">
                <div class="ve-stat">
                    <strong>10K+</strong>
                    <span>Protected Users</span>
                </div>

                <div class="ve-stat-divider"></div>

                <div class="ve-stat">
                    <strong>99.9%</strong>
                    <span>Alert Delivery</span>
                </div>

                <div class="ve-stat-divider"></div>

                <div class="ve-stat">
                    <strong>24/7</strong>
                    <span>Safety Monitoring</span>
                </div>
            </div>
        </div>
        <!-- Right Panel: overlapping image cards -->
        <div class="ve-hero-right">
            <div class="ve-hero-img-main bg-img" style="background-image:url(/img/bg-img/1.jpg);"></div>
            <div class="ve-hero-img-accent bg-img" style="background-image:url(/img/bg-img/3.jpg);"></div>

        </div>
    </section>

    <!-- ===== MARQUEE TRUST BAR ===== -->
    <div class="ve-trust-bar">
        <div class="ve-trust-inner">
            <span><i class="fa fa-shield"></i> 24/7 Emergency Protection</span>
            <span><i class="fa-solid fa-location-dot"></i> Live Location Tracking</span>
            <span><i class="fa fa-bell"></i> One-Tap SOS Alerts</span>
            <span><i class="fa fa-users"></i> Trusted Emergency Contacts</span>
            <span><i class="fa fa-mobile"></i> Instant Mobile Notifications</span>
            <span><i class="fa fa-shield"></i> Privacy & Data Security</span>
            <span><i class="fa fa-phone"></i> Quick Emergency Helpline</span>
            <span><i class="fa fa-heart"></i> Safe Community Support</span>
            <span><i class="fa fa-location-arrow"></i> Real-Time GPS Sharing</span>
            <span><i class="fa fa-lock"></i> End-to-End Encrypted Alerts</span>

            <!-- Repeat for seamless scrolling -->
            <span><i class="fa fa-shield"></i> 24/7 Emergency Protection</span>
            <span><i class="fa-solid fa-location-dot"></i> Live Location Tracking</span>
            <span><i class="fa fa-bell"></i> One-Tap SOS Alerts</span>
            <span><i class="fa fa-users"></i> Trusted Emergency Contacts</span>
            <span><i class="fa fa-mobile"></i> Instant Mobile Notifications</span>
            <span><i class="fa fa-shield"></i> Privacy & Data Security</span>
        </div>
    </div>


    <!-- AI Button -->
<button id="aiButton" class="ai-button">
    <i class="fa-solid fa-robot"></i>
    <!-- <span>AI</span> -->
</button>


<!-- AI Chat Sidebar -->
<div id="aiChat" class="ai-chat">

    <!-- Header -->
    <div class="ai-header">
        <div>
            <i class="fa-solid fa-robot"></i>
            <strong>AI Assistant</strong>
        </div>

        <button id="closeAI" class="close-ai">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>


    <!-- Messages -->
    <div id="aiMessages" class="ai-messages">

        <div class="ai-message">
            <div class="message-icon">
                <i class="fa-solid fa-robot"></i>
            </div>

            <div class="message-text">
                Hello! 👋<br>
                How can I help you today?
            </div>
        </div>

    </div>


    <!-- Input -->
    <form id="aiForm" class="ai-input-area">

        <input
            type="text"
            id="aiInput"
            placeholder="Ask something..."
            autocomplete="off"
        >

        <button type="submit">
            <i class="fa-solid fa-paper-plane"></i>
        </button>

    </form>

</div>

    <!-- ===== SERVICES GRID (new card layout) ===== -->
    <section class="ve-section ve-services-section">
        <div class="container">
            <div class="ve-section-header text-center">
                <span class="ve-section-tag">What We Offer</span>
                <h2>Comprehensive Safety <span>Solutions</span></h2>
                <p>Smart technology and reliable support to keep women and children safe anytime, anywhere.</p>
            </div>

            <div class="ve-services-grid">

                <div class="ve-service-card wow fadeInUp" data-wow-delay="100ms">
                    <div class="ve-service-icon"><i class="icon-smartphone-1"></i></div>
                    <h4>Emergency SOS</h4>
                    <p>Instantly send emergency alerts to trusted contacts and nearby responders with one tap.</p>
                    <a href="#" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

                <div class="ve-service-card wow fadeInUp" data-wow-delay="200ms">
                    <div class="ve-service-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <h4>Live Location Tracking</h4>
                    <p>Share your real-time location with family and emergency services during critical situations.</p>
                    <a href="#" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

                <div class="ve-service-card wow fadeInUp" data-wow-delay="300ms">
                    <div class="ve-service-icon"><i class="fa fa-phone"></i></div>
                    <h4>Emergency Call Support</h4>
                    <p>Quickly connect with emergency services and trusted contacts whenever you need immediate help.
                    </p>
                    <a href="services.html" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

                <div class="ve-service-card wow fadeInUp" data-wow-delay="400ms">
                    <div class="ve-service-icon"><i class="fa fa-users"></i></div>
                    <h4>Trusted Contacts</h4>
                    <p>Add family members and friends who can receive instant alerts during emergencies.</p>
                    <a href="services.html" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

                <div class="ve-service-card wow fadeInUp" data-wow-delay="500ms">
                    <div class="ve-service-icon"><i class="fa fa-camera"></i></div>
                    <h4>Evidence Recording</h4>
                    <p>Automatically capture important evidence during dangerous situations for future action.</p>
                    <a href="services.html" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

                <div class="ve-service-card wow fadeInUp" data-wow-delay="600ms">
                    <div class="ve-service-icon"><i class="fa fa-life-ring"></i></div>
                    <h4>24/7 Support</h4>
                    <p>Get continuous assistance whenever you need help from our safety support network.</p>
                    <a href="services.html" class="ve-card-link">
                        Learn more <i class="fa fa-long-arrow-right"></i>
                    </a>
                </div>

            </div>
        </div>
    </section>

    <!-- ===== WHY US (two-column: image left, content right) ===== -->
    <section class="ve-section ve-whyus-section">
        <div class="container">
            <div class="row align-items-center">

                <!-- Image Side -->
                <div class="col-12 col-lg-5">
                    <div class="ve-whyus-img-wrap wow fadeInLeft" data-wow-delay="100ms">
